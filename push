#!/bin/bash

set -e

MAIN="${MAIN:-main}"

source "$(dirname "$0")/rebase-or-abort"

if ! git rev-parse --git-dir > /dev/null 2>&1; then
  echo 'This is not a git repository.'
  exit 1
fi

if ! current_branch=$(git symbolic-ref --quiet --short HEAD); then
  echo 'This checkout is not on a branch. Check out or create a branch first.'
  exit 1
fi

if [ "$current_branch" == "$MAIN" ]; then
  echo "Rename the branch first. You were about to push your $MAIN branch."
  exit 1
fi

if [[ $(git status --porcelain) ]]; then
  echo 'WARNING! Your branch has uncommitted changes, consider "commit" or "clean".'
fi

base_remote=origin
if (git remote | grep --fixed-strings --line-regexp --quiet 'upstream') then
  base_remote=upstream
fi

git fetch "$base_remote"
rebase_or_abort "$base_remote/$MAIN"

push_log=$(mktemp)
trap 'rm -f "$push_log"' EXIT

set -o pipefail
git push -f --progress origin "HEAD:refs/heads/$current_branch" 2>&1 | tee "$push_log"

# When the server offers a page for opening a pull request, it says so in the
# messages it sends back, each prefixed with "remote:". Take the first URL from
# the offer onwards and hand it to the browser.
pr_url=$(
  sed -n 's/^remote: *//p' "$push_log" |
  awk 'tolower($0) ~ /create (a )?(pull|merge) request/ { offered = 1 }
       offered && match($0, /https?:\/\/[^ \t\r]+/) { print substr($0, RSTART, RLENGTH); exit }'
)

if [ -n "$pr_url" ]; then
  if command -v open > /dev/null; then
    open "$pr_url"
  elif command -v xdg-open > /dev/null; then
    xdg-open "$pr_url"
  fi
fi
