#!/bin/bash

rebase_or_abort() {
  local rebase_apply_dir
  local rebase_in_progress=0
  local rebase_merge_dir

  rebase_apply_dir=$(git rev-parse --git-path rebase-apply)
  rebase_merge_dir=$(git rev-parse --git-path rebase-merge)
  if [ -d "$rebase_apply_dir" ] || [ -d "$rebase_merge_dir" ]; then
    rebase_in_progress=1
  fi

  if git rebase "$1"; then
    return 0
  else
    local rebase_status=$?
  fi

  if [ "$rebase_in_progress" -eq 1 ] || [ -z "$(git ls-files --unmerged)" ]; then
    return "$rebase_status"
  fi

  if [ ! -d "$rebase_apply_dir" ] && [ ! -d "$rebase_merge_dir" ]; then
    return "$rebase_status"
  fi

  git rebase --abort
  printf '\033[33;41mREBASE ABORTED: MERGE CONFLICTS DETECTED\033[0m\n'
  return 1
}
