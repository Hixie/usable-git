#!/bin/sh

set -e

program=${0##*/}
default_count=10
count=
count_was_set=0
min_authors=2
color=auto
date_style=relative
show_hash=1

usage() {
  cat <<EOF
Usage: $program [options] [git-log-arguments]

Show recent commits in one aligned line per commit.

The output starts with a summary line that counts the local branches and names
the current one. When the working tree has uncommitted changes, a line with the
commit ID "[workspace]" appears above the commits, giving the age of the most
recently changed file and a count of the changes.

Commits that are not yet on upstream/main are flagged with a leading "+" in the
left margin. When there is no remote named "upstream", origin/main is used
instead. The branch name comes from \$MAIN when that is set. Long commit
messages are shortened to fit the terminal width.

Those commits are also replayed onto that branch to find where a rebase would
stop. The commit ID appears in reverse video on the commit a rebase would fail
to apply, at most one for each branch in the listing. The replay follows the
rebase: it drops merges and skips commits whose patch that branch already has.
Nothing is marked when the commit a rebase would stop on is older than the
oldest commit shown. Reverse video needs the commit IDs and color, so
--no-hash and --no-color both turn it off.

Options:
  -n, --count N       Show N commits. The default is at least 10, expanded
                      when needed to include at least two authors.
  --min-authors N     In the default count, include enough commits to show N
                      authors when the history contains that many. Default: 2.
  --date STYLE        Use a git log date style. Default: relative.
  --color WHEN        Color output: auto, always, or never. Default: auto.
  --no-color          Same as --color=never.
  --hash              Show abbreviated commit hashes. Default.
  --no-hash           Hide abbreviated commit hashes.
  -h, --help          Show this help.

Arguments not handled by $program are passed to git log. Put $program options
before git log revisions, options, and pathspecs.
EOF
}

die() {
  echo "$program: $1" >&2
  exit 2
}

is_positive_integer() {
  case $1 in
    ''|*[!0123456789]*)
      return 1
      ;;
  esac
  [ "$1" -gt 0 ] 2>/dev/null
}

set_count() {
  is_positive_integer "$1" || die "count must be a positive integer"
  count=$1
  count_was_set=1
}

set_min_authors() {
  is_positive_integer "$1" || die "minimum author count must be a positive integer"
  min_authors=$1
}

plural() {
  if [ "$1" -eq 1 ]; then
    printf '%s %s ago\n' "$1" "$2"
  else
    printf '%s %ss ago\n' "$1" "$2"
  fi
}

plural_unit() {
  if [ "$1" -eq 1 ]; then
    printf '%s %s' "$1" "$2"
  else
    printf '%s %ss' "$1" "$2"
  fi
}

relative_age() {
  diff=$1
  [ "$diff" -ge 0 ] 2>/dev/null || diff=0
  if [ "$diff" -lt 90 ]; then
    plural "$diff" second
    return
  fi
  diff=$(( (diff + 30) / 60 ))
  if [ "$diff" -lt 90 ]; then
    plural "$diff" minute
    return
  fi
  diff=$(( (diff + 30) / 60 ))
  if [ "$diff" -lt 36 ]; then
    plural "$diff" hour
    return
  fi
  diff=$(( (diff + 12) / 24 ))
  if [ "$diff" -lt 14 ]; then
    plural "$diff" day
    return
  fi
  if [ "$diff" -lt 70 ]; then
    plural "$(( (diff + 3) / 7 ))" week
    return
  fi
  if [ "$diff" -lt 365 ]; then
    plural "$(( (diff + 15) / 30 ))" month
    return
  fi
  if [ "$diff" -lt 1825 ]; then
    total_months=$(( (diff * 12 * 2 + 365) / (365 * 2) ))
    years=$(( total_months / 12 ))
    months=$(( total_months % 12 ))
    if [ "$months" -gt 0 ]; then
      printf '%s, %s ago\n' "$(plural_unit "$years" year)" "$(plural_unit "$months" month)"
    else
      plural "$years" year
    fi
    return
  fi
  plural "$(( (diff + 183) / 365 ))" year
}

while [ "$#" -gt 0 ]; do
  case $1 in
    -h|--help)
      usage
      exit 0
      ;;
    -n|--count)
      [ "$#" -gt 1 ] || die "$1 needs a value"
      set_count "$2"
      shift 2
      ;;
    --count=*)
      set_count "${1#*=}"
      shift
      ;;
    -n[0123456789]*)
      set_count "${1#-n}"
      shift
      ;;
    -[0123456789]*)
      set_count "${1#-}"
      shift
      ;;
    --min-authors)
      [ "$#" -gt 1 ] || die "$1 needs a value"
      set_min_authors "$2"
      shift 2
      ;;
    --min-authors=*)
      set_min_authors "${1#*=}"
      shift
      ;;
    --date)
      [ "$#" -gt 1 ] || die "$1 needs a value"
      date_style=$2
      shift 2
      ;;
    --date=*)
      date_style=${1#*=}
      shift
      ;;
    --color)
      [ "$#" -gt 1 ] || die "$1 needs a value"
      color=$2
      shift 2
      ;;
    --color=*)
      color=${1#*=}
      shift
      ;;
    --no-color)
      color=never
      shift
      ;;
    --hash)
      show_hash=1
      shift
      ;;
    --no-hash)
      show_hash=0
      shift
      ;;
    --)
      break
      ;;
    *)
      break
      ;;
  esac
done

case $color in
  auto|always|never)
    ;;
  *)
    die "color must be auto, always, or never"
    ;;
esac

if ! git rev-parse --git-dir >/dev/null 2>&1; then
  echo "$program: not in a git repository" >&2
  exit 128
fi

if ! git rev-parse --verify HEAD >/dev/null 2>&1; then
  exit 0
fi

if [ "$count_was_set" -eq 0 ]; then
  count=$(
    git --no-pager log --format='%an' "$@" |
      awk -v minimum="$default_count" -v minimum_authors="$min_authors" '
        BEGIN {
          count = 0
          author_count = 0
          printed = 0
        }
        {
          count++
          if (!seen[$0]++) {
            author_count++
          }
          if (count >= minimum && author_count >= minimum_authors) {
            print count
            printed = 1
            exit
          }
        }
        END {
          if (!printed) {
            if (count < minimum) {
              print count
            } else {
              print minimum
            }
          }
        }
      '
  )
fi

use_color=0
case $color in
  always)
    use_color=1
    ;;
  auto)
    if [ -t 1 ] && [ -z "${NO_COLOR+x}" ] && [ "${TERM:-}" != dumb ]; then
      use_color=1
    fi
    ;;
esac

if [ -t 1 ]; then
  exec 9<&1
  term_width=$(stty size <&9 2>/dev/null | cut -d' ' -f2)
  exec 9<&-
  case $term_width in
    ''|*[!0123456789]*)
      term_width=$(tput cols 2>/dev/null || echo 80)
      ;;
  esac
  case $term_width in
    ''|*[!0123456789]*)
      term_width=80
      ;;
  esac
else
  term_width=0
fi

if [ "$date_style" = relative ]; then
  date_format='%cr'
else
  date_format='%cd'
fi

field_separator=$(printf '\037')
newline='
'
format="%H%x1f%h%x1f${date_format}%x1f%an%x1f%s"

branch_count=$(git branch | grep -cv '^\* (' || true)
current_branch=$(git branch --show-current)
if [ "$branch_count" -eq 1 ]; then
  branch_label="1 branch"
else
  branch_label="$branch_count branches"
fi
if [ -n "$current_branch" ]; then
  branch_line="$branch_label; current branch: $current_branch"
else
  branch_line="$branch_label; detached HEAD"
fi
if [ "$use_color" -eq 1 ]; then
  printf '\033[1;37m%s\033[0m\n' "$branch_line"
else
  printf '%s\n' "$branch_line"
fi

workspace_row=
name_list=
paths=
# The workspace row describes the working tree the command runs in. A bare
# repository has none, and git will not look at one from inside .git.
#
# git quotes a path that holds a space, a backslash, a quote, or a non-ASCII
# byte, wrapping it in double quotes and escaping the contents, and a quoted
# path names no file. The -z form quotes nothing: it gives the paths as they
# are on disk, one per NUL-separated record. A shell variable cannot hold a
# NUL, so the records are joined with the separator this script already uses
# for its own fields, and a path already holding that byte has it replaced, so
# that every remaining one is a join.
#
# What comes back is one record per changed path, with the two-character status
# code taken off. A rename or a copy takes two records, the path as it is now
# and the path it came from; the path it came from is not a change of its own.
#
# git reports through a pipeline here, where its exit status would be lost, so
# the status follows the records behind an empty record, which git's own output
# never holds, and awk leaves with it.
if [ "$(git rev-parse --is-inside-work-tree 2>/dev/null)" = true ]; then
  paths=$(
    {
      git_status=0
      git status --porcelain -z --untracked-files=normal || git_status=$?
      printf '\000%s' "$git_status"
    } |
      tr '\037\000' "?$field_separator" |
      awk -v separator="$field_separator" '
        BEGIN { RS = separator; ORS = separator }
        reporting_status { exit $0 + 0 }
        $0 == "" { reporting_status = 1; next }
        drop { drop = 0; next }
        {
          drop = substr($0, 1, 2) ~ /[RC]/
          print substr($0, 4)
        }
      '
  )
fi
if [ -n "$paths" ]; then
  if [ "$(stat -f %m . 2>/dev/null)" -ge 0 ] 2>/dev/null; then
    mtime_format=-f%m
  else
    mtime_format=-c%Y
  fi
  # The paths git reports are relative to the top of the working tree, which is
  # not where this ran from, so that is where they are read.
  #
  # The paths go to stat all at once, so a working tree with thousands of
  # changes costs a handful of processes rather than one for each file. A path
  # that is not there any more, because the change was a deletion, is left out
  # of the answer by stat. The paths follow a --, so a name that starts with a
  # dash is a name and not an option.
  newest=$(
    cd "$(git rev-parse --show-toplevel)" || exit
    printf '%s' "$paths" |
      tr "$field_separator" '\000' |
      xargs -0 stat "$mtime_format" -- 2>/dev/null |
      sort --numeric-sort |
      tail -n 1
  )
  # The names shown have their control characters replaced, so each of them
  # takes one line and one column. The paths measured above are the ones on
  # disk, untouched.
  name_list=${paths%"$field_separator"}
  name_list=$(printf '%s' "$name_list" | tr '\001-\036\177' '[?*]')
  now=$(date +%s)
  if [ -n "$newest" ]; then
    age=$(relative_age "$(( now - newest ))")
  else
    age=$(relative_age 0)
  fi
  workspace_row="${field_separator}[workspace]${field_separator}${age}${field_separator}(Uncommitted)${field_separator}"
fi

main_branch=${MAIN:-main}
if git remote | grep --fixed-strings --line-regexp --quiet 'upstream'; then
  upstream_ref=refs/remotes/upstream/$main_branch
else
  upstream_ref=refs/remotes/origin/$main_branch
fi
if [ "$date_style" = relative ]; then
  log_output=$(git --no-pager log --max-count="$count" --format="$format" "$@")
else
  log_output=$(git --no-pager log --max-count="$count" --date="$date_style" --format="$format" "$@")
fi

# Every log line must carry the fields requested above, with the full commit
# hash in field 1. git log options passed through on the command line can
# replace the format or add lines of their own; when that happens, the lines
# cannot be displayed, so the run stops here.
if [ -n "$log_output" ]; then
  format_violation=$(
    printf '%s\n' "$log_output" |
      awk -F "$field_separator" '$1 !~ /^[0-9a-f]+$/ || NF < 5 { print NR; exit }'
  )
  if [ -n "$format_violation" ]; then
    die "git log arguments changed the log output format; options like --graph, --oneline, --pretty, and -p are not supported"
  fi
fi

# Mark the displayed commits that are not reachable from the comparison ref.
# Each log line carries the commit's full hash in field 1. git rev-list
# walks ancestry, so its output also includes commits that are not
# displayed; only the displayed hashes are kept in the exported set.
local_only_hashes=
if [ -n "$log_output" ] && git rev-parse --verify --quiet "$upstream_ref" >/dev/null 2>&1; then
  displayed_hashes=$(printf '%s\n' "$log_output" | cut -d "$field_separator" -f 1)
  unreachable_hashes=$(printf '%s\n' "$displayed_hashes" | git rev-list --stdin --not "$upstream_ref")
  local_only_hashes=$(
    {
      printf '%s\n\n' "$displayed_hashes"
      printf '%s\n' "$unreachable_hashes"
    } |
      awk '
        $0 == "" { separator_seen = 1; next }
        !separator_seen { is_displayed[$0] = 1; next }
        $0 in is_displayed
      '
  )
fi
LOGS_LOCAL_ONLY=$local_only_hashes
export LOGS_LOCAL_ONLY

# awk expands backslash escapes in a -v assignment, so a path holding a
# backslash cannot be passed that way. The environment is read verbatim.
LOGS_WORKSPACE_FILES=$name_list
export LOGS_WORKSPACE_FILES

# Find where a rebase onto the comparison ref would stop, for each branch tip in
# the listing. git replay answers in one pass whether a tip rebases at all; when
# it does not, the commits are replayed one at a time to find the one that stops
# the rebase. That second pass replays the way a rebase does: merges are
# dropped, commits whose patch the comparison ref already has are skipped, and
# each remaining commit is merged onto the tree built so far. Both passes write
# to a scratch object store and never fetch, so a run leaves the repository as
# it found it and stays off the network.
replay_git() {
  GIT_OBJECT_DIRECTORY=$replay_objects GIT_NO_LAZY_FETCH=1 git "$@"
}

conflicting_hashes=
replay_objects=
if [ -n "$local_only_hashes" ] && [ "$use_color" -eq 1 ] && [ "$show_hash" -eq 1 ]; then
  replay_objects=$(mktemp -d 2>/dev/null) || replay_objects=
fi
if [ -n "$replay_objects" ]; then
  trap 'rm -rf "$replay_objects"' EXIT
  trap 'rm -rf "$replay_objects"; trap - INT; kill -s INT $$' INT
  trap 'rm -rf "$replay_objects"; trap - TERM; kill -s TERM $$' TERM
fi
# The alternates file takes one directory per line, so a repository path with a
# colon in it names one directory. GIT_ALTERNATE_OBJECT_DIRECTORIES splits on
# colons.
replay_available=0
if [ -n "$replay_objects" ] && mkdir "$replay_objects/info" 2>/dev/null &&
  git rev-parse --path-format=absolute --git-path objects \
    > "$replay_objects/info/alternates" 2>/dev/null; then
  replay_available=1
fi
if [ "$replay_available" -eq 1 ]; then
  onto_tree=$(git rev-parse "$upstream_ref^{tree}")
  empty_tree=
  # shellcheck disable=SC2086 # the hashes are separate arguments
  for tip in $(git merge-base --independent $local_only_hashes); do
    [ "$replay_available" -eq 1 ] || break
    if replay_git replay --onto "$upstream_ref" "$upstream_ref..$tip" \
      >/dev/null 2>&1; then
      continue
    fi
    already_applied=$newline$(git cherry "$upstream_ref" "$tip" 2>/dev/null |
      sed -n 's/^- //p')$newline
    head_tree=$onto_tree
    last_commit=
    last_tree=
    while IFS=' ' read -r commit tree parent; do
      if [ -z "$parent" ]; then
        if [ -z "$empty_tree" ]; then
          empty_tree=$(git hash-object -t tree /dev/null)
        fi
        base_tree=$empty_tree
      elif [ "$parent" = "$last_commit" ]; then
        base_tree=$last_tree
      else
        base_tree=$(git rev-parse --quiet --verify "$parent^{tree}") || base_tree=
      fi
      last_commit=$commit
      last_tree=$tree
      case $already_applied in
        *"$newline$commit$newline"*)
          continue
          ;;
      esac
      if [ -z "$base_tree" ]; then
        replay_available=0
        break
      fi
      if [ "$head_tree" = "$base_tree" ]; then
        head_tree=$tree
        continue
      fi
      merge_status=0
      head_tree=$(replay_git merge-tree --write-tree --merge-base="$base_tree" \
        "$head_tree" "$tree" 2>/dev/null) || merge_status=$?
      case $merge_status in
        0)
          ;;
        1)
          conflicting_hashes="$conflicting_hashes$commit$newline"
          break
          ;;
        *)
          # git is too old for merge-tree --write-tree, or it could not read an
          # object. Either way the answer is unknown, so nothing is reported.
          replay_available=0
          break
          ;;
      esac
    done <<EOF
$(git --no-pager log --reverse --topo-order --no-merges \
  --format='%H %T %P' "$upstream_ref..$tip")
EOF
  done
  [ "$replay_available" -eq 1 ] || conflicting_hashes=
fi
LOGS_CONFLICTING=$conflicting_hashes
export LOGS_CONFLICTING

{
  if [ -n "$workspace_row" ]; then
    printf '%s\n' "$workspace_row"
  fi
  if [ -n "$log_output" ]; then
    printf '%s\n' "$log_output"
  fi
} |
  awk -F "$field_separator" \
    -v use_color="$use_color" \
    -v show_hash="$show_hash" \
    -v term_width="$term_width" '
    function clip(text, width) {
      if (term_width <= 0) {
        return text
      }
      if (width <= 0) {
        return ""
      }
      if (length(text) <= width) {
        return text
      }
      if (width == 1) {
        return substr(text, 1, 1)
      }
      return substr(text, 1, width - 1) "…"
    }
    BEGIN {
      split("32 36 35 33 31 34", palette, " ")
      palette_size = 6
      escape = sprintf("%c", 27)
      reset = escape "[0m"
      marker_char = "+"
      nfiles = split(ENVIRON["LOGS_WORKSPACE_FILES"], files, sprintf("%c", 31))
      if (nfiles == 1) {
        workspace_summary = "1 file modified"
      } else {
        workspace_summary = nfiles " files modified"
      }
      n_local = split(ENVIRON["LOGS_LOCAL_ONLY"], local_list, "\n")
      for (j = 1; j <= n_local; j++) {
        if (local_list[j] != "") {
          is_local[local_list[j]] = 1
        }
      }
      n_conflicting = split(ENVIRON["LOGS_CONFLICTING"], conflicting_list, "\n")
      for (j = 1; j <= n_conflicting; j++) {
        if (conflicting_list[j] != "") {
          is_conflicting[conflicting_list[j]] = 1
        }
      }
    }
    {
      row_count++
      fullhashes[row_count] = $1
      hashes[row_count] = $2
      dates[row_count] = $3
      authors[row_count] = $4
      subjects[row_count] = $5
      if (length($2) > hash_width) {
        hash_width = length($2)
      }
      if (length($3) > date_width) {
        date_width = length($3)
      }
      if (length($4) > author_width) {
        author_width = length($4)
      }
      if (!($4 in author_color)) {
        author_count++
        author_color[$4] = palette[((author_count - 1) % palette_size) + 1]
      }
    }
    END {
      if (hash_width < 7) {
        hash_width = 7
      }
      first_commit_row = 0
      for (i = 1; i <= row_count; i++) {
        if (hashes[i] != "[workspace]") {
          first_commit_row = i
          break
        }
      }
      any_marked = 0
      for (i = 1; i <= row_count; i++) {
        if (is_local[fullhashes[i]] || hashes[i] == "[workspace]") {
          any_marked = 1
          break
        }
      }
      gutter_width = any_marked ? 2 : 0
      workspace_color = ""
      if (row_count >= 1 && hashes[1] == "[workspace]" && first_commit_row > 0) {
        if (is_local[fullhashes[first_commit_row]]) {
          workspace_color = author_color[authors[first_commit_row]]
        }
      }
      for (i = 1; i <= row_count; i++) {
        is_workspace = (hashes[i] == "[workspace]")
        if (any_marked) {
          if (is_local[fullhashes[i]] || is_workspace) {
            gutter = marker_char " "
          } else {
            gutter = "  "
          }
        } else {
          gutter = ""
        }
        prefix = ""
        suffix = ""
        if (use_color) {
          color_code = author_color[authors[i]]
          if (is_workspace && workspace_color != "") {
            color_code = workspace_color
          }
          prefix = escape "[" color_code "m"
          suffix = reset
        }
        if (show_hash) {
          used = gutter_width + hash_width + 2 + date_width + 2 + author_width + 2
        } else {
          used = gutter_width + date_width + 2 + author_width + 2
        }
        subject_avail = term_width - used
        out_subject = subjects[i]
        if (is_workspace) {
          out_subject = workspace_summary
          if (nfiles >= 1) {
            avail = subject_avail
            ellipsis_overhead = length("…") - 1
            full = workspace_summary ": "
            for (k = 1; k <= nfiles; k++) {
              if (k > 1) {
                full = full ", "
              }
              full = full files[k]
            }
            if (term_width <= 0 || length(full) <= avail) {
              out_subject = full
            } else {
              listed = ""
              for (m = 1; m < nfiles; m++) {
                if (m > 1) {
                  listed = listed ", "
                }
                listed = listed files[m]
                candidate = workspace_summary ": " listed " …and " (nfiles - m) " more"
                if (length(candidate) - ellipsis_overhead <= avail) {
                  out_subject = candidate
                }
              }
            }
          }
          if (out_subject == workspace_summary) {
            out_subject = clip(out_subject, subject_avail)
          }
        } else {
          out_subject = clip(out_subject, subject_avail)
        }
        if (show_hash) {
          hash_field = hashes[i]
          if (use_color && is_conflicting[fullhashes[i]]) {
            hash_field = escape "[7m" hashes[i] escape "[27m"
          }
          printf "%s%s%s%*s  %-*s  %-*s%s  %s\n",
            prefix, gutter, hash_field, hash_width - length(hashes[i]), "",
            date_width, dates[i], author_width, authors[i], suffix, out_subject
        } else {
          printf "%s%s%-*s  %-*s%s  %s\n",
            prefix, gutter, date_width, dates[i],
            author_width, authors[i], suffix, out_subject
        }
      }
    }
  '
