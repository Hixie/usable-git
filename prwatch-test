@case
def a_relay_is_connected_to_and_kept_alive():
    """A watch connects over TCP, and asks the kernel to notice a dead peer.

    The relay here listens on the loopback address of this machine.
    """
    server = socket.create_server(("127.0.0.1", 0))
    port = server.getsockname()[1]
    relay = prwatch.Relay(f"127.0.0.1:{port}")
    theirs, _ = server.accept()
    theirs.sendall(delivery({"repository": {"id": 7}}, "push"))
    theirs.close()
    server.close()
    heard = hear(relay)
    keepalive = relay.connection.getsockopt(socket.SOL_SOCKET,
                                            socket.SO_KEEPALIVE)
    nobody = prwatch.Relay(f"127.0.0.1:{port}")
    nobody.ready.wait()
    problems = []
    if heard != ("push", {"repository": {"id": 7}}):
        problems.append(f"it heard {heard!r}")
    if not keepalive:
        problems.append("the connection is not kept alive")
    if "cannot be connected to" not in (nobody.lost or ""):
        problems.append(f"a relay nobody listens for: {nobody.lost}")
    try:
        prwatch.Relay("no-port-here")
        problems.append("an address with no port was accepted")
    except SystemExit as complaint:
        if "HOST:PORT" not in str(complaint):
            problems.append(f"an address with no port: {complaint}")
    return report("a relay is connected to over TCP and kept alive",
                  problems, "")


@case
def status_does_not_connect_to_the_relay():
    """A single reading has nothing to listen for; a watch connects first,
    and one that cannot connect says so and does not start."""
    connected = []
    real = (prwatch.resolve_target, prwatch.Relay, prwatch.Watcher.run)

    def connect(address):
        connected.append(address)
        relay = FakeRelay(None, [], 0)
        if address == "down:1":
            relay.lost = "the webhook relay at down:1 cannot be connected to"
        return relay

    prwatch.resolve_target = lambda pr, repo: ("github.com", "o", "r", 1)
    prwatch.Relay = connect
    prwatch.Watcher.run = lambda self: connected.append(
        isinstance(self.relay, FakeRelay))
    try:
        prwatch.main(["1", "--status", "--github-webhook-relay", "h:1"])
        prwatch.main(["1", "--once", "--github-webhook-relay", "h:1"])
        try:
            prwatch.main(["1", "--once", "--github-webhook-relay", "down:1"])
            down = "started"
        except SystemExit as complaint:
            down = str(complaint)
    finally:
        prwatch.resolve_target, prwatch.Relay, prwatch.Watcher.run = real
    problems = []
    if connected != [False, "h:1", True, "down:1"]:
        problems.append(f"it went {connected}")
    if "webhook relay at down:1 cannot be connected to" not in down:
        problems.append(f"a relay that is down: {down}")
    return report("--status does not connect to the relay, and a watch does",
                  problems, "")


def main():
    results = [fn() for fn in CASES]
    failed = results.count(False)
    print(f"\n{len(results) - failed}/{len(results)} passed")
    return 1 if failed else 0


if __name__ == "__main__":
    sys.exit(main())
