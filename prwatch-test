def a_refusal_does_not_hold_the_stall_wait_down():
    """A facet that will never be read is not a picture that has gone blind."""
    clock = Clock()
    real = prwatch.time
    prwatch.time = clock
    try:
        watcher = prwatch.Watcher(
            prwatch.GitHub("github.com"), "o", "r", 1,
            Options(stall=10, stall_growth=2, stall_max=40))
        watcher.known.update({"pull": pull(), "checks": check_run("Test")})
        watcher.warned.add("threads")          # refused once, reported once
        watcher.refused.add("threads")
        out = io.StringIO()
        with redirect_stdout(out):
            watcher.heartbeat("waiting")       # take the baseline
        gaps = []
        last = clock.now
        while len(gaps) < 3 and clock.now - last < 200:
            clock.now += 1
            out = io.StringIO()
            with redirect_stdout(out):
                watcher.heartbeat("waiting")
            if "STALL" in out.getvalue():
                gaps.append(clock.now - last)
                last = clock.now
    finally:
        prwatch.time = real
    good = gaps == [10, 20, 40]
    print("ok   a refused facet lets the STALL wait grow" if good
          else f"FAIL refused stall: waits were {gaps}")
    return good


