# -- a token that may not read the checks -----------------------------------
#
# Reading the checks directly needs a permission a fine-grained personal
# access token cannot be given, so on a private repository that read is
# refused for ever. These check what the watch does with that.


class RefusedChecks:
    """A GitHub that refuses the checks and answers everything else.

    `jobs` is what the one workflow run has, as the jobs endpoint gives it,
    and `states` is what the rollup counts, by state.
    """

    hostname = "github.com"

    def __init__(self, jobs, states):
        self.jobs = jobs
        self.states = states

    def paged(self, path, key=None, per_page=100):
        if "/check-runs" in path:
            raise prwatch.GitHubError(
                "Resource not accessible by personal access token (HTTP 403)",
                403)
        assert "/jobs" in path, path
        return self.jobs

    def graphql(self, query, **variables):
        return {"repository": {"object": {"statusCheckRollup": {"contexts": {
            "checkRunCountsByState": [{"state": state.upper(), "count": count}
                                      for state, count in self.states.items()]
        }}}}}


def job(name, status="completed", conclusion="success", jid=1):
    return {"id": jid, "name": name, "status": status,
            "conclusion": conclusion, "html_url": "u"}


def read_refused_checks(jobs, states):
    snap = prwatch.Snapshot()
    snap.runs = workflow()
    gh = RefusedChecks(jobs, states)
    return snap, prwatch.read_checks(gh, "o", "r", "a" * 40, snap)


@case
def workflow_jobs_stand_in_for_the_checks():
    snap, checks = read_refused_checks([job("Test"), job("Lint", jid=2)],
                                       {"success": 2})
    counts = prwatch.tally_checks(checks)
    names = sorted(check["name"] for check in checks.values())
    good = (names == ["Lint", "Test"] and counts["ok"] == 2
            and "checks" in snap.limits)
    print("ok   the jobs of a workflow run stand in for the checks" if good
          else f"FAIL jobs as checks: {names} / {counts} / {snap.limits}")
    return good


@case
def a_check_the_jobs_do_not_cover_is_still_counted():
    """The false green this guards: a review bot's check, unreadable."""
    snap, checks = read_refused_checks([job("Test")],
                                       {"success": 1, "failure": 1})
    counts = prwatch.tally_checks(checks)
    failing = prwatch.failing_names(checks)
    good = counts == {"ok": 1, "bad": 1, "skipped": 0, "cancelled": 0,
                      "pending": 0} and len(failing) == 1
    print("ok   a failing check the jobs cannot name still counts as failing"
          if good else f"FAIL unnamed check: {counts} / {failing}")
    return good


@case
def an_unnamed_check_still_in_flight_holds_the_watch_open():
    snap, checks = read_refused_checks([job("Test")],
                                       {"success": 1, "in_progress": 1})
    counts = prwatch.tally_checks(checks)
    good = counts["pending"] == 1 and counts["ok"] == 1
    print("ok   a check in flight that the jobs cannot name is pending"
