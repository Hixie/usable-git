        return {"id": rid, "name": "Tests", "workflow_id": 1,
                "head_sha": sha * 40, "status": status,
                "conclusion": conclusion, "html_url": "u",
                "run_attempt": 1, "event": "push",
                "created_at": f"2026-10-23T00:{rid:02d}:00Z"}

    class Main:
        """A stand-in for GitHub with runs on main and a merge commit."""

        def __init__(self, runs):
            self.runs = runs
            self.asked = []

        def paged(self, path, key=None, per_page=100):
            self.asked.append(path)
            if path.endswith("/jobs"):
                return [{"name": "unit", "conclusion": "failure",
                         "html_url": "j"},
                        {"name": "lint", "conclusion": None,
                         "html_url": "k"}]
            until = path.partition("..")[2]
            return [given for given in self.runs
                    if not until or given["created_at"] <= until]

        def get(self, path):
            self.asked.append(path)
            sha = path.split("...")[1][0]
            return {"status": {"a": "behind", "m": "identical"}.get(sha,
                                                                    "ahead")}

    def read(runs, held=None):
        gh = Main(runs)
        kept = prwatch.read_base_runs(gh, "repos/o/r", merged, contains, held)
        return kept, gh.asked

    contains = {}
    merged = pull(state="closed", merged=True,
                  merged_at="2026-10-23T00:19:29Z")
    merged["base"]["ref"] = "release/1"
    history = [run(5, "d", "success"), run(4, "c", "failure"),
               run(3, "b", "cancelled"), run(2, "m", "cancelled"),
               run(1, "a", "success")]
    first, asked_first = read(history)
    going, _ = read([run(4, "c", None, "in_progress")] + history[2:])
    again, asked_again = read(history, first)
    rerun = [history[0], run(4, "c", "cancelled")] + history[2:]
    after, asked_after = read(rerun, first)
    problems = []
    if sorted(first, key=int) != ["2", "3", "4"] or first != again:
        problems.append(f"it read {sorted(first)} and then {sorted(again)}")
    jobs = {rid: kept.get("failed") for rid, kept in first.items()}
    failed = [{"name": "unit", "conclusion": "failure", "url": "j"}]
    if jobs != {"2": None, "3": None, "4": failed} or \
            going["4"].get("failed") != failed:
