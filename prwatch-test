def the_end_of_for_is_announced():
    """The watch says that --for ended it, and exits as a working watch does."""
    saved = (prwatch.resolve_target, prwatch.app_from_environment,
             prwatch.Watcher.run,
             {n: signal.getsignal(n) for n in (signal.SIGTERM, signal.SIGHUP)})

    def run_out(self):
        raise prwatch.TimeUp()

    prwatch.resolve_target = lambda pr, repo: ("github.com", "o", "r", 1)
    prwatch.app_from_environment = lambda: None
    prwatch.Watcher.run = run_out
    out = io.StringIO()
