@case
def no_ci_settles_only_after_the_grace_period():
    _, watcher, _ = check(
        "no CI",
        {"pull": pull(), "checks": {}, "runs": {}, "statuses": {},
         "issue_comments": {}, "review_comments": {}, "reviews": {},
         "threads": {}},
        {"pull": pull()}, Options(no_ci_grace=0))
    settled, reason = watcher.is_settled()
    watcher.options.detail = False
    out = io.StringIO()
    with redirect_stdout(out):
        verdict = watcher.final_report(reason, settled)
    good = settled and verdict == "NO-CI"
    print("ok   a commit that never gets a check settles as NO-CI" if good
          else f"FAIL no ci: {settled} / {verdict} / {reason}")
    return good


@case
def a_bad_run_without_a_bad_job_is_red():
