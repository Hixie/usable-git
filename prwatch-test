@case
def a_throttle_is_recorded_from_everything_gh_said():
    """gh's first line is the line worth showing; the wording can be below it.

    Whether a 403 is a wait or a permission is decided by the wording, and
    when the wording is on a later line a watch that reads only the first
    one calls a throttle a permission and stops covering that part of the
    picture for the rest of the run.
    """

    class Refusal:
        """What subprocess.run gives back for a request gh could not make."""

        def __init__(self, stderr):
            self.returncode, self.stdout, self.stderr = 1, "", stderr

    class OnlyRun:
        """A stand-in for the subprocess module, answering every request."""

        def __init__(self, stderr):
            self.stderr = stderr

        def run(self, *arguments, **named):
            return Refusal(self.stderr)

    clock = Clock()
    real_time, real_subprocess = prwatch.time, prwatch.subprocess
    prwatch.time = clock
    problems = []
    try:
        for name, stderr, until in (
                ("a throttle said on the first line",
                 "gh: API rate limit exceeded for user ID 551196 (HTTP 403)",
                 clock.now + 300),
                ("a throttle said below it, naming when it resets",
                 "gh: request failed (HTTP 403)\nYou have exceeded a "
                 "secondary rate limit. X-RateLimit-Reset: 1789958190",
                 1789958190.0),
                ("a permission, which no wait clears",
                 "gh: Resource not accessible by personal access token "
                 "(HTTP 403)", 0.0)):
            prwatch.subprocess = OnlyRun(stderr)
            gh = prwatch.GitHub("github.com")
            raised = None
            try:
                gh.get("repos/o/r/pulls/1")
            except prwatch.GitHubError as error:
                raised = error
            if raised is None:
                problems.append(f"{name}: the failure was not reported")
                continue
            if gh.rate_limited_until != until:
                problems.append(f"{name}: the wait runs to "
                                f"{gh.rate_limited_until}, not to {until}")
            if prwatch.forbidden(raised) != (until == 0.0):
                problems.append(f"{name}: forbidden() calls it "
                                f"{prwatch.forbidden(raised)}")
    finally:
        prwatch.time, prwatch.subprocess = real_time, real_subprocess
    if problems:
        print("FAIL a throttle is recorded from everything gh said")
        for problem in problems:
            print(f"       {problem}")
        return False
    print("ok   a throttle is recorded from everything gh said, and when "
          "it clears")
    return True


@case
def a_throttle_at_the_first_poll_is_waited_out():
    """The reported bug: a watch that started while the token was throttled.

    GitHub refused the first read, prwatch exited, and the pull request went
    unwatched for the rest of the session. The same refusal an hour into a
    watch is waited out, so the first read waits it out too.
    """
    clock = Clock()
    real = prwatch.time
    prwatch.time = clock
    try:
        watcher = prwatch.Watcher(prwatch.GitHub("github.com"), "o", "r", 1,
                                  Options(interval=60))
        polls = []

        def refuse_twice_then_answer():
            polls.append(clock.now)
            snap = prwatch.Snapshot()
            if len(polls) > 2:
                snap.pull = pull()
                return snap
            snap.errors["pull"] = prwatch.GitHubError(
                "gh: API rate limit exceeded for user ID 551196 (HTTP 403)",
                403)
            watcher.gh.rate_limited_until = clock.now + 240
            return snap

        watcher.poll = refuse_twice_then_answer
        out = io.StringIO()
        with redirect_stdout(out):
            snap = watcher.first_poll()
    finally:
        prwatch.time = real
    said = out.getvalue()
    good = (snap.pull is not None and len(polls) == 3
            and said.count("rate limited") == 2
            and polls[1] - polls[0] >= 240)
    print("ok   a throttle at the first poll is waited out, not fatal" if good
          else f"FAIL first-poll throttle: {len(polls)} polls at {polls}, "
               f"which said {said!r}")
    return good


class Waited(Exception):
    """The watch waited for an answer that is never going to change."""


def waiting_is_wrong():
    """A stand-in for sleep() that turns a wait into a failure.

    A watch that waits for an answer that will not change waits for ever,
    which in a test is a run that never finishes rather than a case that
    fails and says why.
    """
    raise Waited()


@case
def a_single_reading_does_not_wait_for_a_throttle():
    """--status answers where a pull request stands now, so it never waits."""
    watcher = prwatch.Watcher(prwatch.GitHub("github.com"), "o", "r", 1,
                              Options(status=True))
    polls = []

    def refuse():
        polls.append("polled")
        snap = prwatch.Snapshot()
        snap.errors["pull"] = prwatch.GitHubError(
            "gh: API rate limit exceeded for user ID 551196 (HTTP 403)", 403)
        return snap

    watcher.poll = refuse
    watcher.sleep = waiting_is_wrong
    complaint = None
    waited = False
    try:
        with redirect_stdout(io.StringIO()):
            watcher.first_poll()
    except SystemExit as raised:
        complaint = str(raised)
    except Waited:
        waited = True
    good = not waited and complaint is not None and polls == ["polled"]
    print("ok   --status reports a throttle rather than waiting it out" if good
          else f"FAIL --status and a throttle: waited={waited} "
               f"complaint={complaint!r} polls={polls}")
    return good


@case
def a_refusal_at_the_first_poll_is_still_fatal():
    """An answer that will not change is not one to wait for.

    A permission the token has not got, a pull request that is not there,
    and a network failure are each answered the same way on the next poll as
    on this one, so each ends the run rather than starting a wait.
    """
    problems = []
    for error in (prwatch.GitHubError("Resource not accessible by personal "
                                      "access token (HTTP 403)", 403),
                  prwatch.GitHubError("Not Found (HTTP 404)", 404),
                  prwatch.GitHubError("dial tcp: no such host", None)):
        watcher = prwatch.Watcher(prwatch.GitHub("github.com"), "o", "r", 1,
                                  Options())
        polls = []

        def refuse():
            polls.append("polled")
            snap = prwatch.Snapshot()
            snap.errors["pull"] = error
            return snap

        watcher.poll = refuse
        watcher.sleep = waiting_is_wrong
        complaint = None
        try:
            with redirect_stdout(io.StringIO()):
                watcher.first_poll()
        except SystemExit as raised:
            complaint = str(raised)
        except Waited:
            problems.append(f"{error} started a wait that would never end")
            continue
        if complaint is None:
            problems.append(f"{error} did not end the run")
        elif "cannot read o/r#1" not in complaint or str(error) not in \
                complaint:
            problems.append(f"{error} was reported as {complaint!r}")
        if polls != ["polled"]:
            problems.append(f"{error} was read {len(polls)} times: {polls}")
    if problems:
        print("FAIL a refusal at the first poll is still fatal")
        for problem in problems:
            print(f"       {problem}")
        return False
    print("ok   a failure that will not clear still ends the run at once")
    return True


