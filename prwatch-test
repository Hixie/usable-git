spec = importlib.util.spec_from_loader(
    "prwatch",
    importlib.machinery.SourceFileLoader("prwatch", sys.argv[1]))
prwatch = importlib.util.module_from_spec(spec)
spec.loader.exec_module(prwatch)
prwatch.resolve_target = lambda pr, repo: ("github.com", "o", "r", 1)


def wait_to_be_killed(self):
    print("watching", flush=True)
    time.sleep(30)


prwatch.Watcher.run = wait_to_be_killed
sys.exit(prwatch.main([]))
