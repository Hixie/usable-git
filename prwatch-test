# -- listening to a webhook relay ------------------------------------------

def delivery(payload, event="ping", form=False):
    """One webhook as the relay sends it: its length, then GitHub's request."""
    body = json.dumps(payload).encode()
    kind = "application/json"
    if form:
        body = urllib.parse.urlencode({"payload": body}).encode()
        kind = "application/x-www-form-urlencoded"
    request = (f"POST /webhook HTTP/1.1\r\nHost: relay\r\n"
               f"Content-Type: {kind}\r\nContent-Length: {len(body)}\r\n"
               f"X-GitHub-Event: {event}\r\n\r\n").encode() + body
    return len(request).to_bytes(4, "big") + request


def relay_receiving(*chunks, repositories=None):
    """A Relay reading `chunks` from a connection that then closes."""
    ours, theirs = socket.socketpair()
    relay = prwatch.Relay("relay:1", ours)
    relay.repositories = repositories
    for chunk in chunks:
        theirs.sendall(chunk)
    theirs.close()
    return relay


def hear(relay):
    """The next webhook, or the reason the relay was lost."""
    try:
        return relay.next(time.time() + 3600)
    except prwatch.RelayLost as lost:
        return str(lost)


@case
def webhooks_are_read_from_the_relay():
    """Each webhook is a length and a request, in either encoding GitHub uses.

    Once the watch names its repositories, webhooks from others are dropped.
    """
    check = {"repository": {"id": 7}, "check_run": {"head_sha": "a" * 40}}
    comment = {"repository": {"id": 7}, "issue": {"number": 5}}
    elsewhere = {"repository": {"id": 8}, "ref": "refs/heads/main"}
    everything = relay_receiving(delivery(check, "check_run"),
                                 delivery(comment, "issue_comment", form=True),
                                 delivery(elsewhere, "push"))
    heard = [hear(everything) for _ in range(4)]
    ours = relay_receiving(delivery(elsewhere, "push"),
                           delivery(check, "check_run"), repositories={7})
    filtered = [hear(ours) for _ in range(2)]
    end = "the webhook relay at relay:1 closed the connection"
    problems = []
    if heard != [("check_run", check), ("issue_comment", comment),
                 ("push", elsewhere), end]:
        problems.append(f"it heard {heard}")
    if filtered != [("check_run", check), end]:
        problems.append(f"with one repository named, it heard {filtered}")
    return report("webhooks are read from the relay, and so is its end",
                  problems, "")


@case
def a_relay_that_stops_making_sense_is_lost():
    """Anything after a frame that cannot be read is unreadable too."""
    good = delivery({"repository": {"id": 7}})
    # A frame cut short is the last thing on its connection, and the others
    # are followed by a webhook that could otherwise have been read.
    endings = {
        "a body that is not JSON":
            ([b"\0\0\0\x05hello", good], "not a GitHub webhook"),
        "a payload that is not an object":
            ([delivery([1, 2]), good], "not a GitHub webhook"),
        "a repository that is not an object":
            ([delivery({"repository": 5}), good], "not a GitHub webhook"),
        "a length no webhook has":
            ([b"\xff\xff\xff\xff", good], "which no webhook has"),
        "a frame cut short": ([good[:-3]], "partway through a webhook"),
        "a length cut short": ([good[:2]], "partway through a webhook"),
    }
    problems = []
    for name, (chunks, wanted) in endings.items():
        relay = relay_receiving(good, *chunks)
        first, then = hear(relay), hear(relay)
        if first != ("ping", {"repository": {"id": 7}}):
            problems.append(f"the webhook before {name} was heard as {first}")
        if not isinstance(then, str) or wanted not in then:
            problems.append(f"{name} was heard as {then!r}")
    return report("a frame that cannot be read loses the relay", problems, "")


def gh_comment(cid=1, body="hello", updated="2026-09-20T10:00:00Z",
               path=None, reply_to=None):
    """A comment as GitHub sends it, inline when it has a path."""
    comment = {"id": cid, "user": {"login": "someone"}, "updated_at": updated,
               "html_url": "u", "body": body}
    if path:
        comment.update(path=path, line=1, in_reply_to_id=reply_to)
    return comment


def gh_check(cid=9, status="completed", conclusion="failure", sha="a" * 40,
             app="a-bot"):
    return {"id": cid, "name": "Bot", "status": status,
            "conclusion": conclusion, "html_url": "u", "app": {"slug": app},
            "head_sha": sha}


def webhook_for(repository=7, **fields):
    return {"repository": {"id": repository}, **fields}


def heard_by(watcher, event, payload):
    """What a watcher says when it hears one webhook, and what it reads."""
    out = io.StringIO()
    with redirect_stdout(out):
        reads = watcher.hear(event, payload)
    return out.getvalue(), reads


@case
def a_webhook_says_what_a_read_would():
