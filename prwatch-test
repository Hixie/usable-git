@case
def landed_watches_main_until_a_run_finishes_behind_the_merge():
    """--landed carries a watch past the merge, through cancelled runs on
    main, to the first run that finishes on a commit that contains it.

    Each --once run exits at the first thing no earlier run reported: the
    merge, then the cancelled run for the merge commit, then the verdict on
    the run that took its place. A failure names the workflow, the job and
    the commit, and RED waits for news, such as the run being run again,
    while LANDED is over, so every --once run gives it at once.
    """
    later = "b" * 40
    merged = {"state": "closed", "merged": True}
    waiting = base_run("1", status="queued", conclusion=None)
    cancelled = base_run("1", conclusion="cancelled")
    replaced = {**cancelled, **base_run("2", later, status="in_progress",
                                        conclusion=None)}
    failed = {**cancelled, **base_run("2", later, conclusion="failure",
                                      failed=["unit"])}
    passed = {**cancelled, **base_run("2", later)}
    outcomes = {}
    with tempfile.TemporaryDirectory() as directory:
        for ending, runs in (("failed", failed), ("passed", passed)):
            state = str(Path(directory) / f"{ending}.json")
            process(state, [{}], once=True, landed=True)
            outcomes[ending] = [process(state, readings, once=True,
                                        landed=True) for readings in (
                [dict(merged, base_runs=waiting)] * 4,
                [dict(merged, base_runs=replaced)] * 4,
                [dict(merged, base_runs=runs)] * 6,
                [dict(merged, base_runs=runs)] * 6,
                [dict(merged, base_runs={**cancelled, **base_run(
                    "2", later, status="queued", conclusion=None)})] * 4)]
    merge, cancel, verdict, again, rerun = outcomes["failed"]
    problems = []
    if merge[1:] != (1, "PENDING") or "MERGED" not in tags(merge[0]) or \
            "merged as mmmmmmmmm; watching main" not in merge[0] or \
            "Tests started on main at mmmmmmmmm  u1" not in merge[0] or \
            "never read" in merge[0]:
        problems.append(f"the merge gave {merge[1:]}:\n{merge[0]}")
    if cancel[1:] != (1, "PENDING") or \
            not {"CANCEL", "RUN"} <= set(tags(cancel[0])) or \
            "Tests on main at mmmmmmmmm was cancelled" not in cancel[0] or \
            "Tests started on main at bbbbbbbbb, which contains " \
            "mmmmmmmmm" not in cancel[0]:
        problems.append(f"the cancelled run gave {cancel[1:]}:\n{cancel[0]}")
    if verdict[1:] != (3, "RED") or \
            "FAIL     Tests / unit — failure on main at bbbbbbbbb" \
            not in verdict[0] or \
            "failing job: Tests / unit (failure)  j-unit" not in verdict[0] \
            or "failing on main at bbbbbbbbb, which contains mmmmmmmmm: " \
            "Tests (failure)  u2" not in verdict[0]:
        problems.append(f"the failure gave {verdict[1:]}:\n{verdict[0]}")
    if again[2] is not None:
        problems.append(f"a --once after RED gave {again[1:]}:\n{again[0]}")
    if rerun[1:] != (1, "PENDING") or "RERUN" not in tags(rerun[0]) or \
            "Tests on main at bbbbbbbbb, which contains mmmmmmmmm went back" \
            not in rerun[0]:
        problems.append(f"running it again gave {rerun[1:]}:\n{rerun[0]}")
    passed = outcomes["passed"]
    if passed[2][1:] != (3, "LANDED") or "FAIL" in tags(passed[2][0]) or \
            passed[3][1:] != (3, "LANDED"):
        problems.append(f"a pass gave {passed[2][1:]} then {passed[3][1:]}:"
                        f"\n{passed[2][0]}{passed[3][0]}")
    return report("--landed watches main until a run finishes behind the "
                  "merge", problems, "".join(
                      output for output, _, _ in outcomes["failed"]))


