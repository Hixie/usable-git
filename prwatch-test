    problems = []
    if len(comments) != 3 or said.index("WAITING") < comments[-1]:
        problems.append(f"it said {said}")
    if polls != [0]:
        problems.append(f"it read {polls}")
    return report("a verdict waits for quiet steps, not for webhooks",
                  problems, output)


@case
def a_relayed_verdict_waits_for_the_reads_webhooks_ask_for():
    """Quiet steps are 10 seconds, or --interval when shorter, down to 5.

    No verdict is given while a read a webhook asked for is outstanding,
    including the second read that a read going back on a webhook needs,
    and those reads, like the polls after the relay is lost, keep to
    --interval. A relay that is lost starts the quiet over.
    """
    def comment(at):
        return (at, ("issue_comment", webhook_for(
            issue={"number": 1}, action="created",
            comment=gh_comment(cid=at, updated=f"2026-09-20T10:00:{at:02}Z"))))

    # A check the watch does not hold, which a read then leaves out, so
    # the read is doubted and made again.
    rerun = (20, ("check_run", webhook_for(check_run=gh_check(
        cid=9, status="queued", conclusion=None))))
    lost = (200, None)
    # Each case says whether the verdict comes before the comment, or
    # None when no verdict comes at all.
    problems = []
    for name, webhooks, options, horizon, early, reads in [
            ("a quiet watch", [comment(25), lost], {}, 300, True,
             [0, 200, 260]),
            ("a 1-second --interval", [comment(7), lost], {"interval": 1},
             300, False, [0, 200, 205]),
            ("a check to read", [rerun, comment(90), lost], {}, 300, False,
             [0, (60, {"checks"}), (120, {"checks"})]),
            ("a relay lost while settling", [(15, None)], {}, 100, None,
             [0, 15, 75])]:
        output, polls, _ = relayed(lambda now: {}, webhooks, horizon=horizon,
                                   **options)
        said = tags(output)
        if early is None:
            wrong = "WAITING" in said
        else:
            wrong = "COMMENT" not in said or "WAITING" not in said or \
                (said.index("WAITING") < said.index("COMMENT")) != early
        if wrong:
            problems.append(f"{name} said {said}")
        if polls[:len(reads)] != reads:
            problems.append(f"{name} read {polls}")
    return report("a relayed verdict waits for the reads webhooks ask for",
                  problems, "")


@case
def a_relayed_watch_waits_out_a_throttle():
    """A read GitHub refuses as throttled is not made again until the
    throttle has been waited out, whether the relay is still there or is
    lost during the wait. The wait is reported once, and the verdict waits
    for the read."""
    def readings(now):
        if 100 <= now < 400:
            return {"throttled_until": 400}
        return {"mergeable": "dirty"} if now >= 400 else {}

    push = (100, ("push", webhook_for(ref="refs/heads/main")))
    comment = (150, ("issue_comment", webhook_for(
        issue={"number": 1}, action="created", comment=gh_comment())))
    problems = []
    # A check not held, whose read waits on the pull request's, so a
    # throttle on the pull request leaves it unread too.
    rerun = (100, ("check_run", webhook_for(check_run=gh_check(
        cid=9, status="queued", conclusion=None))))
    # A watch that has lost its relay polls on, so only its first reads
    # are known; a listening watch stops reading once it has its answers.
    for name, webhooks, reads, polling in [
            ("listening", [push, comment], [0, (100, {"pull"}),
                                            (405, {"pull"})], False),
            ("with a check to read too", [push, rerun, comment],
             [0, (100, {"pull", "checks"}), (405, {"pull", "checks"}),
              (465, {"checks"})], False),
            ("with the relay lost", [push, comment, (200, None)],
             [0, (100, {"pull"}), 405], True)]:
        output, polls, _ = relayed(readings, webhooks, horizon=1000)
        said = tags(output)
        if (polls[:len(reads)] if polling else polls) != reads:
            problems.append(f"{name}, it read {polls}")
        if output.count("rate limited; waiting") != 1 or \
                "rate limited; waiting 5m" not in output:
            problems.append(f"{name}, the wait was not reported once, as "
                            "five minutes")
        if "COMMENT" not in said or "CONFLICT" not in said or \
                "WAITING" in said[said.index("COMMENT"):
                                  said.index("CONFLICT")] or \
                "WAITING" not in said[said.index("CONFLICT"):]:
            problems.append(f"{name}, it said {said}")
    return report("a relayed watch waits out a throttle", problems, "")


