# -- --once: a watch that ends at the next piece of news ----------------------

class RanOut(Exception):
    """The case has no more readings to give the watch."""


def reading(head="a" * 40, run="completed", conclusion="success",
            comments=None, state="open", merged=False, lint=None,
            mergeable="clean", base_runs=None):
    """One poll of a pull request with one workflow run and one check.

    A `lint` of "queued" or "success" adds a second check in that state.
    `base_runs` are the runs on the branch it merged into, unread if None.
    """
    finished = conclusion if run == "completed" else None
    snap = prwatch.Snapshot()
    snap.pull = pull(head=head, state=state, merged=merged,
                     mergeable=mergeable)
    snap.checks = check_run("Test", status=run, conclusion=finished)
    if lint:
        snap.checks.update(check_run(
            "Lint", status="completed" if lint == "success" else lint,
            conclusion=lint if lint == "success" else None))
    snap.runs = workflow(status=run, conclusion=finished)
    snap.statuses = {}
    snap.issue_comments = comments or {}
    snap.review_comments = {}
    snap.reviews = {}
    snap.threads = {}
    snap.base_runs = base_runs
    return snap


def process(state, readings, local="a" * 40, **options):
    """One prwatch process on the state file `state`, run to its end.

    Each entry of `readings` is the keyword arguments for one poll, and
    `local` is the commit checked out in the working tree. Returns what the
    process printed, how many polls it made, and the verdict it ended on,
    which is None when it was still watching after the last one.
    """
    clock = Clock()
    started = clock.now
    real = prwatch.time
    prwatch.time = clock
    polls = []
    watcher = prwatch.Watcher(prwatch.GitHub("github.com"), "o", "r", 1,
                              Options(fresh=False, state=state, **options))
    watcher.local_commit = lambda: local

    def poll(facets=prwatch.Snapshot.FACETS):
        if len(polls) == len(readings):
            raise RanOut()
        polls.append(clock.now)
        snap = reading(**readings[len(polls) - 1])
        if "base_runs" not in watcher.readable(facets):
            snap.base_runs = None
        return snap

    watcher.poll = poll
    out = io.StringIO()
    verdict = None
    try:
        with redirect_stdout(out):
            verdict = watcher.run()
    except RanOut:
        pass
    except prwatch.TimeUp:
        verdict = f"time up after {clock.now - started:.0f}s"
    finally:
        prwatch.time = real
    return out.getvalue(), len(polls), verdict


def tags(output):
    """The tag of every event line, in order."""
    return [line.split()[2] for line in output.splitlines()
            if not line.startswith(" ")]


@case
def once_waits_for_news_and_then_stops():
    """--once exits at the first thing no earlier run reported, and no sooner.

    The first run has nothing to compare with, so it answers the way
    --status does. The second finds the same verdict and the same commit it
    was told to expect, neither of which is news, and waits until somebody
    comments. The third has heard of that comment, and waits on, through a
    check that registers and passes without a line being printed about it.
    """
    comment = {"1": {"user": "someone", "updated": "2026-09-20T10:00:00Z",
                     "url": "u", "body": "one more thing"}}
    quiet = [{}] * 6
    with tempfile.TemporaryDirectory() as directory:
        state = str(Path(directory) / "state.json")
        first = process(state, quiet, once=True, expect="HEAD")
        second = process(state, [{}] * 5 + [{"comments": comment}] + quiet,
                         once=True, expect="HEAD")
        third = process(state, [{"comments": comment, "lint": "queued"}] * 2
                        + [{"comments": comment, "lint": "success"}] * 4,
                        once=True, expect="HEAD")
    problems = []
    if first[1:] != (1, "GREEN") or "WAITING" not in tags(first[0]):
        problems.append(f"the first run gave {first[1:]}:\n{first[0]}")
    if second[1:] != (6, "GREEN") or \
            tags(second[0])[-2:] != ["COMMENT", "WAITING"] or \
            "MATCH" in tags(second[0]):
        problems.append(f"the second run gave {second[1:]}:\n{second[0]}")
    if third[1:] != (6, None) or \
            {"COMMENT", "WAITING"} & set(tags(third[0])):
        problems.append(f"the third run gave {third[1:]}:\n{third[0]}")
    if problems:
        print("FAIL --once waits for news and then stops")
        for problem in problems:
            print("       " + problem.replace("\n", "\n       "))
        return False
    print("ok   --once waits for news and then stops")
    return True


@case
def once_hears_of_a_mismatch_once():
    """A commit made while the head is behind the working tree is not news.

    The first run finds the head behind and says so. The second finds a
    later commit in the working tree with the head still behind, which the
    first run already said, and waits; a run without --expect between the
    two does not make it forget. The third finds that the commit
    before it has landed, which is not the commit now checked out, and says
    so. The fourth finds the head has caught up.
    """
    quiet = [{}] * 6
    with tempfile.TemporaryDirectory() as directory:
        state = str(Path(directory) / "state.json")
        first = process(state, quiet, local="b" * 40, once=True,
                        expect="HEAD")
        process(state, quiet, once=True)
        second = process(state, quiet, local="c" * 40, once=True,
                         expect="HEAD")
        third = process(state, [{"head": "b" * 40}] * 6, local="c" * 40,
                        once=True, expect="HEAD")
        fourth = process(state, [{"head": "c" * 40}] * 6, local="c" * 40,
                         once=True, expect="HEAD")
    problems = []
    if "MISMATCH" not in tags(first[0]):
        problems.append(f"the first run said {tags(first[0])}")
    if second[2] is not None or "MISMATCH" in tags(second[0]):
        problems.append(f"the second run gave {second[1:]} and said "
                        f"{tags(second[0])}")
    if not {"RETARGET", "MISMATCH"} <= set(tags(third[0])) or \
            "HEAD is ccccccccc" not in third[0]:
        problems.append(f"the third run said {tags(third[0])}")
    if not {"RETARGET", "MATCH"} <= set(tags(fourth[0])):
        problems.append(f"the fourth run said {tags(fourth[0])}")
    return report("--once hears of a mismatch once", problems,
                  first[0] + second[0] + third[0] + fourth[0])


