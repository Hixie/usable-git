@case
def a_throttle_is_recorded_from_everything_gh_said():
    """gh's first line is the line worth showing; the wording can be below it.

    Whether a 403 is a wait or a permission is decided by the wording, and
    when the wording is on a later line a watch that reads only the first
    one calls a throttle a permission and stops covering that part of the
    picture for the rest of the run.
    """

    class Refusal:
        """What subprocess.run gives back for a request gh could not make."""

        def __init__(self, stderr):
            self.returncode, self.stdout, self.stderr = 1, "", stderr

    class OnlyRun:
        """A stand-in for the subprocess module, answering every request."""

        def __init__(self, stderr):
            self.stderr = stderr

        def run(self, *arguments, **named):
            return Refusal(self.stderr)

    clock = Clock()
    real_time, real_subprocess = prwatch.time, prwatch.subprocess
    prwatch.time = clock
    problems = []
    try:
        for name, stderr, until in (
                ("a throttle said on the first line",
                 "gh: API rate limit exceeded for user ID 551196 (HTTP 403)",
                 clock.now + 300),
                ("a throttle said below it, naming when it resets",
                 "gh: request failed (HTTP 403)\nYou have exceeded a "
                 "secondary rate limit. X-RateLimit-Reset: 1789958190",
                 1789958190.0),
                ("a permission, which no wait clears",
                 "gh: Resource not accessible by personal access token "
                 "(HTTP 403)", 0.0)):
            prwatch.subprocess = OnlyRun(stderr)
            gh = prwatch.GitHub("github.com")
            raised = None
            try:
                gh.get("repos/o/r/pulls/1")
            except prwatch.GitHubError as error:
                raised = error
            if raised is None:
                problems.append(f"{name}: the failure was not reported")
                continue
            if gh.rate_limited_until != until:
                problems.append(f"{name}: the wait runs to "
                                f"{gh.rate_limited_until}, not to {until}")
            if prwatch.forbidden(raised) != (until == 0.0):
                problems.append(f"{name}: forbidden() calls it "
                                f"{prwatch.forbidden(raised)}")
    finally:
        prwatch.time, prwatch.subprocess = real_time, real_subprocess
    if problems:
        print("FAIL a throttle is recorded from everything gh said")
        for problem in problems:
            print(f"       {problem}")
        return False
    print("ok   a throttle is recorded from everything gh said, and when "
          "it clears")
    return True


@case
def a_throttle_at_the_first_poll_is_waited_out():
    """The reported bug: a watch that started while the token was throttled.

    GitHub refused the first read, prwatch exited, and the pull request went
    unwatched for the rest of the session. The same refusal an hour into a
    watch is waited out, so the first read waits it out too.
    """
    clock = Clock()
    real = prwatch.time
    prwatch.time = clock
    try:
        watcher = prwatch.Watcher(prwatch.GitHub("github.com"), "o", "r", 1,
                                  Options(interval=60))
