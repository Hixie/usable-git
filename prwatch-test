@case
def a_run_left_out_of_one_read_is_not_news():
    """A run GitHub leaves out of one list is not announced when it returns.

    The read that leaves it out counts as a failed read of the runs, so the
    runs keep what they had. A run left out of two reads in a row was
    deleted, so the second list is taken as it stands. A new head has runs
    of its own, so its list is not held to the old head's.
    """

    class Runs:
        """A stand-in for GitHub that lists the runs it is given."""

        def __init__(self, sha):
            self.sha = sha
            self.runs = []

        def get(self, path):
            if "/pulls/" not in path:
                return {}
            return {**pull(head=self.sha),
                    "base": {"repo": {"full_name": "o/r"}}}

        def paged(self, path, key=None, per_page=100):
            return self.runs if "actions/runs" in path else []

        def graphql(self, query, **variables):
            raise prwatch.GitHubError("not read in this case")

        def forget_unread(self):
            pass

    gh = Runs("a" * 40)
    ran = {"id": 1, "name": "CI", "status": "completed",
           "conclusion": "success", "html_url": "u"}
    watcher = prwatch.Watcher(gh, "o", "r", 1, Options())
    lines = []
    listed = []
    readings = [([ran], "a"), ([], "a"), ([ran], "a"), ([], "a"), ([], "a"),
                ([ran], "b"), ([], "c")]
    for count, (runs, sha) in enumerate(readings):
        gh.runs, gh.sha = runs, sha * 40
        out = io.StringIO()
        with redirect_stdout(out):
            snap = watcher.poll()
            # The first reading is the baseline, as it is in a real watch.
            watcher.absorb(snap, announce=count > 0)
        lines += [line.split(None, 2)[2] for line in out.getvalue().splitlines()
                  if " RUN " in line or " WARN     runs" in line]
        listed.append(None if snap.runs is None else list(snap.runs))
    good = (lines == ["RUN      CI completed success  u"]
            and listed == [["1"], None, ["1"], None, [], ["1"], []])
    print("ok   a run left out of one read is not news" if good
          else f"FAIL a run left out of one read: {lines} / {listed}")
    return good


