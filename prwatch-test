#!/usr/bin/env python3
"""Drive prwatch's change detection with made-up data and check what it says.

The events worth having are the rare ones, and the rare ones are the ones a
live pull request will not produce on demand: a cancelled run, a check that
goes back to pending, a branch that starts conflicting, a commit with no CI
at all. This feeds those situations to the same methods the watcher uses and
compares the lines that come out.

Run it with no arguments. It touches no network and no repository.
"""

import importlib.machinery
import importlib.util
import io
import sys
from contextlib import redirect_stdout
from pathlib import Path

spec = importlib.util.spec_from_loader(
    "prwatch",
    importlib.machinery.SourceFileLoader("prwatch",
                                         str(Path(__file__).with_name("prwatch"))))
prwatch = importlib.util.module_from_spec(spec)
spec.loader.exec_module(prwatch)


class Options:
    """The defaults, so each case names only what it cares about."""

    def __init__(self, **overrides):
        defaults = dict(expect=None, once=False, follow=False, interval=60,
                        heartbeat=900, stall=1800, stall_growth=2,
                        stall_max=86400, stability=3, min_checks=0,
                        no_ci_grace=900, warn_after=3, max_lines=12,
                        detail=True, fresh=True, state=None, exit_code=False,
                        require_review=None, excerpt=300)
        defaults.update(overrides)
        self.__dict__.update(defaults)


def check(name, snapshot_fields, known, options=None, head="a" * 40):
    """Absorb one snapshot on top of `known` and return the lines emitted."""
    watcher = prwatch.Watcher(prwatch.GitHub("github.com"), "o", "r", 1,
                              options or Options())
    watcher.known.update(known)
    watcher.head = known.get("_head", head)
    snap = prwatch.Snapshot()
    for field, value in snapshot_fields.items():
        setattr(snap, field, value)
    out = io.StringIO()
    with redirect_stdout(out):
        watcher.absorb(snap, announce=True)
    return name, watcher, out.getvalue()


def run_check(fn, expected, forbidden=()):
    name, watcher, output = fn()
    problems = [f"missing {want!r}" for want in expected if want not in output]
    problems += [f"unwanted {no!r}" for no in forbidden if no in output]
    if problems:
        print(f"FAIL {name}")
        for problem in problems:
            print(f"       {problem}")
        print("     got:")
        for line in output.splitlines():
            print(f"       {line}")
        return False
    print(f"ok   {name}")
    return True


def pull(head="a" * 40, state="open", merged=False, mergeable="clean"):
    return {"head": {"sha": head}, "state": state, "merged": merged,
            "mergeable_state": mergeable, "title": "t", "draft": False,
            "html_url": "https://example.invalid/pull/1"}


def check_run(name, status="completed", conclusion="success", cid=None):
    return {cid or name: {"name": name, "status": status,
                          "conclusion": conclusion, "url": "u", "app": "a"}}


def workflow(name="CI", status="completed", conclusion="success", rid="1"):
    return {rid: {"name": name, "status": status, "conclusion": conclusion,
                  "url": "u", "attempt": 1, "event": "pull_request"}}


def review(user="cubic-dev-ai[bot]", commit="a" * 40, rid="1", state="COMMENTED"):
    return {rid: {"user": user, "state": state, "commit": commit, "url": "u",
                  "body": "looks fine"}}


def thread(resolved=False, tid="t1"):
    return {tid: {"resolved": resolved, "outdated": False, "path": "f.py",
                  "line": 1, "author": "someone", "url": "u", "body": "why?"}}


class Clock:
    """A stand-in for the time module, so a test can skip ahead by hours."""

    def __init__(self, now=1000.0):
        self.now = now

    def time(self):
        return self.now

    def strftime(self, fmt):
        return "00:00"


CASES = []


def case(fn):
    CASES.append(fn)
    return fn


# -- the events a green watch never reaches ---------------------------------

@case
def cancelled_is_not_a_failure():
    return run_check(
        lambda: check(
            "a cancelled check is announced as a cancellation",
            {"pull": pull(), "checks": check_run("Test", conclusion="cancelled")},
            {"pull": pull(), "checks": check_run("Test", status="in_progress",
                                                 conclusion=None),
             "_head": "a" * 40}),
        expected=["CANCEL", "Test", "not a test result"],
        forbidden=["FAIL"])


@case
def rerun_goes_back_to_pending():
    return run_check(
        lambda: check(
            "a check that returns to pending is announced as a rerun",
            {"pull": pull(), "checks": check_run("Test", status="queued",
                                                 conclusion="")},
            {"pull": pull(), "checks": check_run("Test"), "_head": "a" * 40}),
        expected=["RERUN", "Test"])


@case
def empty_conclusion_is_not_a_verdict():
    _, watcher, _ = check(
        "an empty conclusion counts as pending, not as a failure",
        {"pull": pull(), "checks": check_run("Test", status="queued",
                                             conclusion=""),
         "runs": workflow(status="in_progress", conclusion=None)},
        {"pull": pull()})
    counts = prwatch.tally_checks(watcher.known["checks"])
    settled, reason = watcher.is_settled()
    good = (counts["pending"], counts["bad"], settled) == (1, 0, False)
    print("ok   an empty conclusion counts as pending, not as a failure"
          if good else f"FAIL empty conclusion: {counts} {settled} {reason}")
    return good


@case
def conflict_is_announced():
    return run_check(
        lambda: check(
            "a branch that starts conflicting is announced",
            {"pull": pull(mergeable="dirty")},
            {"pull": pull(mergeable="clean")}),
        expected=["CONFLICT", "no longer merges cleanly"])


@case
def expectation_met_is_announced():
    options = Options(expect=None)
    watcher = prwatch.Watcher(prwatch.GitHub("github.com"), "o", "r", 1, options)
    watcher.expect = "b" * 40
    watcher.expect_met = False
    watcher.head = "a" * 40
    snap = prwatch.Snapshot()
    snap.pull = pull(head="b" * 40)
    out = io.StringIO()
    with redirect_stdout(out):
        watcher.absorb(snap, announce=True)
    output = out.getvalue()
    good = "MATCH" in output and "RETARGET" in output
    print("ok   the head becoming the awaited commit is announced" if good
          else f"FAIL awaited commit: {output}")
    return good


@case
def closed_without_merging():
    _, watcher, output = check(
        "a pull request closed without merging",
        {"pull": pull(state="closed")},
        {"pull": pull(state="open")})
    settled, reason = watcher.is_settled()
    good = "CLOSED" in output and settled and "without merging" in reason
    print("ok   a pull request closed without merging settles as closed"
          if good else f"FAIL closed: {output} / {reason}")
    return good


