        wide, wide_continuation = lines(1234567)
    finally:
        prwatch.time = real
    problems = []
    if event != "00:00 #6922  FAIL     Test — failure":
        problems.append(f"event line is {event!r}")
    if continuation.index("a continuation") != event.index("Test"):
        problems.append(f"the continuation does not line up: {continuation!r}")
    if "#1234567" not in wide:
        problems.append(f"a number too wide for the padding was cut: {wide!r}")
    if wide_continuation.index("a") != wide.index("Test"):
        problems.append(f"a wide number left the continuation behind: "
                        f"{wide_continuation!r}")
    if problems:
        print("FAIL every line carries the number")
        for problem in problems:
            print(f"       {problem}")
        return False
    print("ok   every event line carries the pull request number")
    return True


@case
def stall_reports_back_off():
    """A quiet pull request is reported less often the longer it stays quiet."""
    clock = Clock()
    real = prwatch.time
    prwatch.time = clock
    try:
        watcher = prwatch.Watcher(
            prwatch.GitHub("github.com"), "o", "r", 1,
            Options(stall=10, stall_growth=2, stall_max=25))
        watcher.known.update({"pull": pull(), "checks": check_run("Test")})

        def tick():
            """One poll, and whatever it printed."""
            out = io.StringIO()
            with redirect_stdout(out):
                watcher.heartbeat("waiting")
            return out.getvalue()

        def waits(count):
            """How long each of the next `count` STALL reports waited.

            Short of `count` entries when the reports stop coming, which the
            comparison below then fails on.
            """
            gaps = []
            last = clock.now
            while len(gaps) < count and clock.now - last < 100:
                clock.now += 1
                if "STALL" in tick():
                    gaps.append(clock.now - last)
                    last = clock.now
            return gaps

        tick()                                 # take the baseline
        grew = waits(4)
        watcher.warned.add("checks")           # GitHub stops answering
        blind = waits(3)
        watcher.warned.discard("checks")       # and answers again
        watcher.known["checks"] = check_run("Test", conclusion="failure")
        tick()                                 # something moved
        after = waits(1)
    finally:
        prwatch.time = real
    good = grew == [10, 20, 25, 25] and blind == [10, 10, 10] and after == [10]
    print("ok   STALL waits longer each time, except while a read is failing"
          if good else
          f"FAIL stall backoff: waits were {grew}, then {blind} while a read "
          f"was failing, then {after}")
    return good


def quiet_watcher(options):
    """A watcher holding a green pull request that nobody is touching."""
    watcher = prwatch.Watcher(prwatch.GitHub("github.com"), "o", "r", 1,
                              options)
    watcher.known.update({"pull": pull(), "checks": check_run("Test"),
                          "runs": workflow(), "statuses": {},
                          "issue_comments": {}, "review_comments": {},
                          "reviews": {}, "threads": {}})
    watcher.head = "a" * 40
    watcher.merge_state = "clean"
    return watcher


def quiet_polls(watcher, clock, count):
    """The pace after each of `count` polls that find nothing."""
    paces = []
    for _ in range(count):
        clock.now += 1
        with redirect_stdout(io.StringIO()):
            watcher.heartbeat("waiting")
        paces.append(watcher.poll_interval)
    return paces


@case
def polling_slows_down_while_nothing_changes():
    """A pull request nobody has touched since the morning is read less often.

    Several watches, each reading its own pull request every minute under
    one token, is what GitHub refuses. A watch that has given its verdict
    and is waiting for a person loses nothing by reading less often, so the
    wait grows until it reaches --interval-max. A build still in flight is
    read at --interval throughout.
    """
    clock = Clock()
    real = prwatch.time
    prwatch.time = clock
    try:
        watcher = quiet_watcher(Options(interval=60, interval_growth=2,
                                        interval_max=240))
        watcher.reported_settled = True
        waiting_for_a_person = quiet_polls(watcher, clock, 5)
        watcher.reported_settled = False       # a push, and CI starts again
        build_in_flight = quiet_polls(watcher, clock, 3)
    finally:
        prwatch.time = real
    good = (waiting_for_a_person == [60, 120, 240, 240, 240]
            and build_in_flight == [60, 60, 60])
    print("ok   polling slows down once there is nothing left to wait for"
          if good else
          f"FAIL poll backoff: waits were {waiting_for_a_person} with the "
          f"verdict in, and {build_in_flight} with a build in flight")
    return good


@case
def the_watch_loop_waits_longer_as_it_finds_nothing():
    """The gaps between polls, measured through run() rather than around it.

    The pace is worked out in one place and spent in another, and the other
    cases about it read the number rather than the wait it produces. This
    one drives the loop itself, with a clock that moves when the watch
    sleeps, and records when each poll lands.
    """

    class Enough(Exception):
        """Long enough: the case has the polls it came for."""

    comment = {"1": {"user": "someone", "updated": "2026-09-20T10:00:00Z",
                     "url": "u", "body": "one more thing"}}
    clock = Clock()
    real = prwatch.time
    prwatch.time = clock
    polls = []
    try:
        with tempfile.TemporaryDirectory() as directory:
            watcher = prwatch.Watcher(
                prwatch.GitHub("github.com"), "o", "r", 1,
                Options(interval=60, interval_growth=2, interval_max=240,
                        stability=1, follow=True, detail=False,
                        state=str(Path(directory) / "state.json")))

            def poll():
                polls.append(clock.now)
                if len(polls) > 8:
                    raise Enough()
                snap = prwatch.Snapshot()
                snap.pull = pull()
                snap.checks = check_run("Test")
                snap.runs = workflow()
                snap.statuses = {}
                # Somebody comments on the sixth reading. Nothing else ever
                # changes.
                snap.issue_comments = {} if len(polls) < 6 else comment
                snap.review_comments = {}
                snap.reviews = {}
                snap.threads = {}
                return snap

            watcher.poll = poll
            with redirect_stdout(io.StringIO()):
                try:
                    watcher.run()
                except Enough:
                    pass
    finally:
        prwatch.time = real
    gaps = [round(later - earlier)
            for earlier, later in zip(polls, polls[1:])]
    good = gaps == [120, 240, 240, 240, 240, 60, 120, 240]
    print("ok   the loop spreads its polls out, and comes back on a comment"
          if good else f"FAIL the loop waited {gaps} between polls")
    return good


@case
def a_change_puts_the_poll_pace_back():
    """Anything happening at all means reading at --interval again, at once."""
    comment = {"1": {"user": "someone", "updated": "2026-09-20T10:00:00Z",
                     "url": "u", "body": "hello"}}
    changes = {
        "a new head": lambda w: setattr(w, "head", "b" * 40),
        "a check result": lambda w: w.known.update(
            {"checks": check_run("Test", conclusion="failure")}),
        "a check going back to pending": lambda w: w.known.update(
            {"checks": check_run("Test", status="queued", conclusion=None)}),
        "a comment": lambda w: w.known.update({"issue_comments": comment}),
        "an inline comment": lambda w: w.known.update(
            {"review_comments": comment}),
        "a review": lambda w: w.known.update({"reviews": review()}),
        "a thread": lambda w: w.known.update({"threads": thread()}),
        "a conflict": lambda w: setattr(w, "merge_state", "dirty"),
        "a merge": lambda w: w.known.update(
            {"pull": pull(state="closed", merged=True)}),
        "a read that failed": lambda w: w.warned.add("threads"),
    }
    real = prwatch.time
    problems = []
    for name, change in changes.items():
        clock = Clock()
        prwatch.time = clock
        try:
            watcher = quiet_watcher(Options(interval=60, interval_growth=2,
                                            interval_max=600))
            watcher.reported_settled = True
            backed_off = quiet_polls(watcher, clock, 4)[-1]
            change(watcher)
            after = quiet_polls(watcher, clock, 1)[-1]
        finally:
            prwatch.time = real
        if backed_off <= 60:
            problems.append(f"the pace had not grown before {name}: "
                            f"{backed_off}")
        if after != 60:
            problems.append(f"{name} left the pace at {after}")
    if problems:
        print("FAIL a change puts the poll pace back")
        for problem in problems:
            print(f"       {problem}")
        return False
    print("ok   any change puts the pace back to --interval at once")
    return True


@case
def a_wait_that_shrinks_is_refused():
    """The options that widen the wait cannot be set to narrow it instead."""
    problems = []
    for argv, wanted in [(["--stall-growth", "0.5"], "--stall-growth"),
                         (["--stall-growth", "-1"], "--stall-growth"),
                         (["--stall", "60", "--stall-max", "30"],
                          "--stall-max"),
                         (["--interval-growth", "0.5"], "--interval-growth"),
                         (["--interval", "0"], "--interval"),
                         (["--interval", "60", "--interval-max", "30"],
                          "--interval-max")]:
        try:
            # The target is deliberately unreadable, so that a run which gets
            # past the check stops before it reaches the network.
            prwatch.main(["not-a-pull-request", *argv])
        except SystemExit as complaint:
            if wanted not in str(complaint):
                problems.append(f"{argv} was refused with {complaint}")
        else:
            problems.append(f"{argv} was accepted")
    if problems:
        print("FAIL a wait that shrinks is refused")
        for problem in problems:
            print(f"       {problem}")
        return False
    print("ok   options that would make the wait shrink are refused")
    return True


@case
def the_wait_stops_growing_at_four_minutes():
    """--interval-max defaults to 240, or to --interval where that is longer."""

    class Parsed(Exception):
        pass

    def capture(gh, owner, repo, number, options):
        raise Parsed(options.interval_max)

    real = (prwatch.resolve_target, prwatch.GitHub, prwatch.Watcher)
    prwatch.resolve_target = lambda pr, repo: ("github.com", "o", "r", 1)
    prwatch.GitHub = lambda hostname: None
    prwatch.Watcher = capture
    problems = []
    try:
        for argv, wanted in [([], 240), (["--interval", "30"], 240),
                             (["--interval", "600"], 600),
                             (["--interval-max", "900"], 900)]:
            try:
                prwatch.main(["1", *argv])
            except Parsed as parsed:
                if parsed.args[0] != wanted:
                    problems.append(f"{argv} gave a ceiling of "
                                    f"{parsed.args[0]}, not {wanted}")
    finally:
        prwatch.resolve_target, prwatch.GitHub, prwatch.Watcher = real
    if problems:
        print("FAIL the wait stops growing at four minutes")
        for problem in problems:
            print(f"       {problem}")
        return False
    print("ok   the wait stops growing at four minutes unless told otherwise")
    return True


@case
def a_killed_watch_says_so():
    """A signal ends the watch with a line naming it, and still kills it."""
    # The watch runs in a child process, because the point of the case is
    # what a signal does to a whole run: the line it prints, and the status
    # the process leaves behind.
    child = subprocess.Popen(
        [sys.executable, "-c", KILLABLE_WATCH, str(Path(__file__).with_name("prwatch"))],
        stdout=subprocess.PIPE, text=True)
    problems = []
    if child.stdout.readline().strip() != "watching":
        problems.append("the child never reached the watch")
    else:
        child.send_signal(signal.SIGTERM)
    said = child.stdout.read()
    child.wait()
    if "STOPPED" not in said or "SIGTERM" not in said:
        problems.append(f"the line it ended on was {said.strip()!r}")
    if child.returncode != -signal.SIGTERM:
        problems.append(f"it left status {child.returncode}, not a SIGTERM "
                        "death")
    if problems:
        print("FAIL a killed watch says so")
        for problem in problems:
            print(f"       {problem}")
        return False
    print("ok   a signal ends the watch with a line naming it")
    return True


KILLABLE_WATCH = """
import importlib.machinery, importlib.util, sys, time
spec = importlib.util.spec_from_loader(
    "prwatch",
    importlib.machinery.SourceFileLoader("prwatch", sys.argv[1]))
prwatch = importlib.util.module_from_spec(spec)
spec.loader.exec_module(prwatch)
prwatch.resolve_target = lambda pr, repo: ("github.com", "o", "r", 1)


def wait_to_be_killed(self):
    print("watching", flush=True)
    time.sleep(30)


prwatch.Watcher.run = wait_to_be_killed
sys.exit(prwatch.main([]))
"""


def main():
    results = [fn() for fn in CASES]
    failed = results.count(False)
    print(f"\n{len(results) - failed}/{len(results)} passed")
    return 1 if failed else 0


if __name__ == "__main__":
    sys.exit(main())
