@case
def no_ci_settles_only_after_the_grace_period():
    _, watcher, _ = check(
        "no CI",
        {"pull": pull(), "checks": {}, "runs": {}, "statuses": {},
         "issue_comments": {}, "review_comments": {}, "reviews": {},
         "threads": {}},
