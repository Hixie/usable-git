@case
def a_run_on_main_is_read_for_while_it_may_count():
    """After a merge, --landed reads for a run on main that may count.

    That is a run held, whose webhook is kept for the read to be held to,
    a run of a workflow whose every run so far was cancelled, a run on the
    commit whose workflows count, and any run before one is held, as well
    as a job that failed in a run held. A later run of a workflow that is
    decided is not read for, and nor is a run of a workflow that did not
    run for that commit, a run on another branch, a run no push started,
    a job that passed, or anything without --landed, before the merge, or
    once the verdict is LANDED.
    """
    def watcher(landed=True, merged=True, verdict=None, decided=True):
        watching = quiet_watcher(Options(landed=landed))
        if merged:
            watching.known["pull"] = pull(state="closed", merged=True)
        watching.known["base_runs"] = base_run("1", conclusion="cancelled")
        if decided:
            watching.known["base_runs"].update(base_run(
                "2", "b" * 40, status="in_progress", conclusion=None))
        watching.verdict = verdict
        return watching

    def job(conclusion, run_id=2):
        return webhook_for(workflow_job={
            "id": 9, "run_id": run_id, "name": "unit", "status": "completed",
            "conclusion": conclusion, "html_url": "j", "head_sha": "b" * 40})

    later = "c" * 40
    finished = webhook_for(workflow_run=gh_base_run(2, "b" * 40))
    empty = watcher()
    empty.known["base_runs"] = {}
    cases = [
        ("a run held finishing", watcher(), finished, {"base_runs"}),
        ("a run held, as it is held", watcher(), webhook_for(
            workflow_run=gh_base_run(2, "b" * 40, "in_progress", None)),
         set()),
        ("a run of a workflow every run of which was cancelled",
         watcher(decided=False), webhook_for(workflow_run=gh_base_run(
             5, later, "queued", None)), {"base_runs"}),
        ("a run on the commit whose workflows count", watcher(),
         webhook_for(workflow_run=gh_base_run(5, MERGE, "queued", None,
                                              workflow=2)), {"base_runs"}),
        ("a run before any is held", empty, webhook_for(
            workflow_run=gh_base_run(5, later, workflow=2)), {"base_runs"}),
        ("a later run of a decided workflow", watcher(), webhook_for(
            workflow_run=gh_base_run(5, later, "queued", None)), set()),
        ("a run of a workflow that did not run for the merge", watcher(),
         webhook_for(workflow_run=gh_base_run(5, later, "queued", None,
                                              workflow=2)), set()),
        ("a run on another branch", watcher(), webhook_for(
            workflow_run=gh_base_run(5, branch="other", workflow=2)),
         set()),
        ("a run no push started", watcher(), webhook_for(
            workflow_run=gh_base_run(5, event="schedule", workflow=2)),
         set()),
        ("a job that failed in a run held", watcher(), job("failure"),
         {"base_runs"}),
        ("a job that passed in a run held", watcher(), job("success"),
         set()),
        ("a run without --landed", watcher(landed=False), finished, set()),
        ("a run before the merge", watcher(merged=False), finished, set()),
        ("a run after LANDED", watcher(verdict="LANDED"), finished, set()),
    ]
    problems = []
    for name, watching, payload, reads in cases:
        event = "workflow_job" if "workflow_job" in payload \
            else "workflow_run"
        said, asked = heard_by(watching, event, payload)
        if said or asked != reads:
            problems.append(f"{name} said {said.strip()!r} and read {asked}")
    held = cases[0][1].announced
    if held != {("base_runs", "2"): {"status": "completed",
                                     "conclusion": "success", "attempt": 1}}:
        problems.append(f"a run held finishing was kept as {held}")
    merged, opened = watcher(), watcher(merged=False)
    if merged.readable() != ("pull", "issue_comments", "review_comments",
                             "reviews", "threads", "base_runs") or \
            "checks" not in opened.readable() or \
            "base_runs" in opened.needs_reading():
        problems.append(f"after the merge it reads {merged.readable()}, and "
                        f"before, {opened.readable()} and needs "
                        f"{opened.needs_reading()}")
    return report("a run on main is read for while it may count", problems,
                  "")


class FakeRelay:
    """Webhooks that arrive at set times on a Clock, until `horizon`.

    A webhook that is None is the relay being lost.
    """

    def __init__(self, clock, webhooks, horizon):
        self.clock = clock
        self.webhooks = sorted(webhooks, key=lambda webhook: webhook[0])
        self.horizon = horizon
        self.address = "r:1"
        self.repositories = None
        self.lost = None
        self.ready = threading.Event()
        self.ready.set()

    closed = []

    def close(self):
        FakeRelay.closed.append(self)

    def next(self, until):
        if self.webhooks and self.webhooks[0][0] <= until:
            at, heard = self.webhooks.pop(0)
            self.clock.now = max(self.clock.now, at)
            if heard is None:
                raise prwatch.RelayLost("the webhook relay at r:1 closed the "
                                        "connection")
            return heard
        if until > self.horizon:
            raise RanOut()
        self.clock.now = max(self.clock.now, until)
        return None


def relayed(readings, webhooks, horizon=20000, local=None, reconnect=None,
            **options):
    """One --follow watch through a relay, run until `horizon` seconds in.

    `readings` gives the keyword arguments for reading() for a poll made a
    given number of seconds into the watch, or `throttled_until` for a poll
    GitHub refuses until then, and `webhooks` is a list of the
    times webhooks arrive at and what each is. `local` gives the commit
    checked out in the working tree at a given time, and `reconnect` the
    relay a connection made at a given time reaches. Returns what the watch
    printed, the time and facets of each read, and how it ended.
    """
    clock = Clock(now=0.0)
    real = (prwatch.time, prwatch.Relay)
    prwatch.time = clock
    polls = []
    ended = "still watching"
    if reconnect:
        prwatch.Relay = lambda address: reconnect(clock)
    try:
        with tempfile.TemporaryDirectory() as directory:
            watcher = prwatch.Watcher(
                prwatch.GitHub("github.com"), "o", "r", 1,
                Options(follow=True, detail=False,
                        state=str(Path(directory) / "state.json"), **options),
                FakeRelay(clock, webhooks, horizon))

            def poll(facets=prwatch.Snapshot.FACETS):
                # A watch that lost its relay ends the case here instead.
                if clock.now > horizon:
                    raise RanOut()
                whole = facets == prwatch.Snapshot.FACETS
                polls.append(round(clock.now) if whole
                             else (round(clock.now), set(facets)))
                given = readings(clock.now)
                until = given.pop("throttled_until", None)
                snap = reading(**given)
                snap.read = set(facets)
                if until:
                    # As read_snapshot() does, a pull request that could
                    # not be read leaves no commit to read the checks of.
                    if "pull" in facets:
                        snap.read -= {"runs", "checks", "statuses"}
                    for facet in snap.read:
                        snap.errors[facet] = prwatch.GitHubError(
                            "gh: API rate limit exceeded (HTTP 403)", 403)
                    watcher.gh.rate_limited_until = max(
                        watcher.gh.rate_limited_until, until)
                for facet in prwatch.Snapshot.FACETS:
                    if facet not in snap.read or until:
                        setattr(snap, facet, None)
                watcher.report_errors(snap)
                return snap

            watcher.poll = poll
            if local:
                watcher.local_commit = lambda: local(clock.now)
            out = io.StringIO()
            with redirect_stdout(out):
                try:
                    watcher.run()
                except RanOut:
                    pass
                except prwatch.TimeUp:
                    ended = f"time up after {clock.now:.0f}s"
    finally:
        prwatch.time, prwatch.Relay = real
    return out.getvalue(), polls, ended


def report(name, problems, output):
    if problems:
        print(f"FAIL {name}")
        for problem in problems:
            print(f"       {problem}")
        for line in output.splitlines():
            print(f"       {line}")
        return False
    print(f"ok   {name}")
    return True


@case
def a_read_of_some_facets_leaves_the_others_alone():
    """Reading only the pull request keeps what is known of everything else.

    The answers GitHub gave for the facets left unread are kept, so that it
    can still answer "not modified" for them, and a facet whose reads were
    failing is not said to be read again by a read that never asked for it.
    """
    gh = prwatch.GitHub("github.com")
    gh.answers = {"comments": ("e1", "[]")}
    gh.reading = {"pull": ("e2", "{}")}
    gh.keep_read()
    kept = sorted(gh.answers)
    watcher = quiet_watcher(Options())
    watcher.failures["threads"] = 3
    watcher.warned.add("threads")
    partial = prwatch.Snapshot()
    partial.read = {"pull"}
    partial.pull = pull()
    out = io.StringIO()
    with redirect_stdout(out):
        watcher.report_errors(partial)
    still_failing = watcher.failures["threads"]
    whole = prwatch.Snapshot()
    with redirect_stdout(out):
        watcher.report_errors(whole)
    calls = []

    class Recorder:
        hostname = "github.com"

        def forget_unread(self):
            calls.append("forget")

        def keep_read(self):
            calls.append("keep")

    real = prwatch.read_snapshot
    prwatch.read_snapshot = lambda *args: prwatch.Snapshot()
    try:
        watcher.gh = Recorder()
        watcher.poll(("pull",))
        watcher.poll()
    finally:
        prwatch.read_snapshot = real
    problems = []
    if kept != ["comments", "pull"]:
        problems.append(f"after a read of some paths, it kept {kept}")
    if still_failing != 3 or out.getvalue().count("reading again") != 1:
        problems.append(f"a read of the pull request alone left the threads "
                        f"at {still_failing} failures and said "
                        f"{out.getvalue().strip()!r}")
    if calls != ["keep", "forget"]:
        problems.append(f"the answers were kept and forgotten as {calls}")
    return report("a read of some facets leaves the others alone", problems,
                  "")


