@case
def each_read_reports_the_allowance_left_and_uses_the_token():
    """The allowance left comes from the headers of every REST answer.

    A 304 carries them too. REST and GraphQL have separate allowances, and
    the figure is the smaller share left; an answer with no headers leaves
    it as it was. A token source puts its token where gh looks for one on
    any host, beside the rest of the environment; without one, gh is left
    to find its own.
    """

    class Answer:
        def __init__(self, stdout, returncode=0, stderr=""):
            self.stdout, self.returncode, self.stderr = stdout, returncode, \
                stderr

    class Script:
        def __init__(self, *answers):
            self.answers = list(answers)
            self.envs = []

        def run(self, cmd, env=None, **named):
            self.envs.append(env and (env.get("GH_TOKEN"),
                                      env.get("GH_ENTERPRISE_TOKEN"),
                                      env.get("PATH") == prwatch.os.environ.get("PATH")))
            return self.answers.pop(0)

    def head(status, left, resource="core"):
        return (f"HTTP/2.0 {status}\nEtag: W/\"e\"\r\nX-Ratelimit-Limit: 5000"
                f"\r\nX-Ratelimit-Remaining: {left}\r\n"
                f"X-Ratelimit-Resource: {resource}\r\n\r\n")

    real_subprocess = prwatch.subprocess
    script = prwatch.subprocess = Script(
        Answer(head("200 OK", 4000) + "{}"),
        Answer(head("304 Not Modified", 1250), 1, "gh: HTTP 304"),
        Answer('{"data": {}}'),
        Answer(head("200 OK", 1000, "graphql") + '{"data": {}}'),
        Answer(head("200 OK", 5000) + "{}"))
    seen = []
    try:
        gh = prwatch.GitHub("github.com")
        seen.append(gh.quota_left)
        gh.get("repos/o/r/pulls/1")
        seen.append(gh.quota_left)
        gh.get("repos/o/r/pulls/1")
        seen.append(gh.quota_left)
        gh.graphql("query{}")
        seen.append(gh.quota_left)
        gh.graphql("query{}")
        seen.append(gh.quota_left)
        gh.token = lambda: "installation-token"
        gh.get("repos/o/r/pulls/2")
        seen.append(gh.quota_left)
    finally:
        prwatch.subprocess = real_subprocess
    token = ("installation-token", "installation-token", True)
    good = (seen == [None, 0.8, 0.25, 0.25, 0.2, 0.2]
            and script.envs == [None, None, None, None, token])
    print("ok   each read reports the allowance left, under the right token"
          if good else f"FAIL allowance and token: {seen} / {script.envs}")
    return good


@case
def an_app_token_is_made_and_renewed():
    """A token is asked for with a signed request, and again near its end.

    The request is a JSON Web Token naming the app, signed with its private
    key. The installation is the first whose token can read the repository,
    which is found once: GitHub's lookup of an installation by repository
    does not follow a rename, and a read does. The token in hand is reused
    until it has five minutes left. GitHub's refusals are reported with the
    message it gave.
    """
    problems = []
    with tempfile.TemporaryDirectory() as scratch:
        key = Path(scratch, "app.pem")
        public = Path(scratch, "public.pem")
        made = subprocess.run(["openssl", "genrsa", "-out", str(key), "2048"],
                              capture_output=True)
        subprocess.run(["openssl", "rsa", "-in", str(key), "-pubout", "-out",
                        str(public)], capture_output=True)
        if made.returncode != 0 or not public.exists():
            print("FAIL an app token is made and renewed: no key was made")
            return False

        clock = Clock(now=1790000000.0)
        start = clock.now
        sent = []
        answers = []

        # GitHub's clock is a thousand seconds behind this one.
        skew = 1000

        class Response(io.BytesIO):
            headers = {"Date": email.utils.formatdate(clock.now - skew,
                                                      usegmt=True)}

        def urlopen(request):
            jwt = request.get_header("Authorization").removeprefix("Bearer ")
            sent.append((request.get_method(), request.full_url, jwt,
                         request.data and json.loads(request.data)))
            if not answers:
                raise prwatch.urllib.error.URLError("an unexpected request")
            answer = answers.pop(0)
            if isinstance(answer, Exception):
                raise answer
            response = Response(json.dumps(answer).encode())
            response.headers = {"Date": email.utils.formatdate(
                clock.now - skew, usegmt=True)}
            return response

        def expiry(seconds):
            return datetime.fromtimestamp(
                clock.now - skew + seconds, timezone.utc
            ).isoformat().replace("+00:00", "Z")

        real = prwatch.time, prwatch.urllib.request.urlopen
        prwatch.time = clock
        prwatch.urllib.request.urlopen = urlopen
        try:
            token = prwatch.AppToken("github.com", "123", str(key), "o/r")
            answers[:] = [[{"id": 41}, {"id": 42}],
                          {"token": "zero", "expires_at": expiry(3600)},
                          prwatch.urllib.error.HTTPError(
                              "u", 404, "Not Found", {},
                              io.BytesIO(b'{"message": "Not Found"}')),
                          {"token": "one", "expires_at": expiry(3600)},
                          {"full_name": "o/r"}]
            got = []
            try:
                got.append(token())
                clock.now += 3000
                got.append(token())
                clock.now += 400
                answers[:] = [{"token": "two", "expires_at": expiry(3600)}]
                got.append(token())
            except prwatch.GitHubError as error:
                got.append(str(error))
            if got != ["one", "one", "two"]:
                problems.append(f"the tokens were {got}")
            paths = [(method, url) for method, url, _, _ in sent]
            if sent[3][3] != {"permissions": {
                    "actions": "read", "checks": "read", "contents": "read",
                    "issues": "read", "metadata": "read",
                    "pull_requests": "read", "statuses": "read"}}:
                problems.append(f"the token asked for was {sent[3][3]}")
            if [jwt for _, _, jwt, _ in sent[:5]][2::2] != ["zero", "one"]:
                problems.append("the repository was not read with the "
                                "installation's own token")
            if paths != [
                    ("GET", "https://api.github.com/app/installations"
                            "?per_page=100"),
                    ("POST", "https://api.github.com/app/installations/41/"
                             "access_tokens"),
                    ("GET", "https://api.github.com/repos/o/r"),
                    ("POST", "https://api.github.com/app/installations/42/"
                             "access_tokens"),
                    ("GET", "https://api.github.com/repos/o/r"),
                    ("POST", "https://api.github.com/app/installations/42/"
                             "access_tokens")]:
                problems.append(f"the requests were {paths}")
            header, claims, signature = sent[0][2].split(".")

            def decode(part):
                return base64.urlsafe_b64decode(part + "=" * (-len(part) % 4))

            claims = json.loads(decode(claims))
            if json.loads(decode(header)) != {"alg": "RS256", "typ": "JWT"}:
                problems.append(f"the JWT header was {decode(header)}")
            if claims["iss"] != "123" or claims["exp"] - claims["iat"] > 600 \
                    or claims["iat"] > start:
                problems.append(f"the JWT claims were {claims}")
            Path(scratch, "signature").write_bytes(decode(signature))
            verified = subprocess.run(
                ["openssl", "dgst", "-sha256", "-verify", str(public),
                 "-signature", str(Path(scratch, "signature"))],
                input=sent[0][2].rsplit(".", 1)[0].encode(),
                capture_output=True)
            if verified.returncode != 0:
                problems.append("the JWT signature does not verify")

            # A failure to renew is not reported while the token in hand
            # still works, and is once it has run out.
            answers[:] = [prwatch.http.client.RemoteDisconnected("gone")]
            clock.now += 3400
            try:
                if token() != "two":
                    problems.append("a failed renewal lost the token in hand")
            except Exception as error:
                problems.append(f"a failed renewal, with the token in hand "
                                f"still good, raised {error!r}")
            answers[:] = [prwatch.urllib.error.HTTPError(
                "u", 403, "Forbidden", {},
                io.BytesIO(b'{"message": "installation suspended"}'))]
            clock.now += 300
            try:
                token()
                problems.append("a refusal was taken as a token")
            except Exception as error:
                if not isinstance(error, prwatch.GitHubError) or \
                        error.status is not None or \
                        "installation suspended" not in str(error):
                    problems.append(f"the refusal said {error!r}, "
                                    f"status {error.status}")
                elif prwatch.forbidden(error):
                    problems.append("a refused token was called a permission")

            # An app that no installation of can read the repository.
            absent = prwatch.AppToken("github.com", "123", str(key), "o/r")
            answers[:] = [[{"id": 41}],
                          {"token": "zero", "expires_at": expiry(3600)},
                          prwatch.urllib.error.HTTPError(
                              "u", 404, "Not Found", {},
                              io.BytesIO(b'{"message": "Not Found"}'))]
            try:
                absent()
                problems.append("an app not installed on the repository "
                                "gave a token")
            except prwatch.GitHubError as error:
                if "not installed on o/r" not in str(error) or absent.token:
                    problems.append(f"an app not installed said {error}, "
                                    f"and kept {absent.token!r}")

            roots = [prwatch.AppToken(host, "1", "k", "o/r").api
                     for host in ("github.com", "acme.ghe.com",
                                  "github.acme.com")]
            if roots != ["https://api.github.com", "https://api.acme.ghe.com",
                         "https://github.acme.com/api/v3"]:
                problems.append(f"the API was at {roots}")
        finally:
            prwatch.time, prwatch.urllib.request.urlopen = real
    if problems:
        print("FAIL an app token is made and renewed")
        for problem in problems:
            print(f"       {problem}")
        return False
    print("ok   an app token is made with a signed request, and renewed")
    return True


@case
def an_answer_that_has_not_changed_is_reused():
    """A read names the last answer's ETag, and a 304 gives that answer back.

    A 200 replaces the answer, and a 304 for a path with no answer yet is a
    failure rather than an empty reading. An answer is kept for one poll
    after the last one that read its path, and no longer.
    """

    class Answer:
        def __init__(self, status, etag=None, body=""):
            head = f"HTTP/2.0 {status}\n" + (f"Etag: {etag}\r\n" if etag else "")
            self.head = f"{head}X-Ratelimit-Used: 1\r\n\r\n"
            self.body = body
            self.returncode = 0 if status == 200 else 1
            self.stderr = "" if status == 200 else f"gh: HTTP {status}"

    class Script:
        """A stand-in for the subprocess module, giving answers in turn."""

        def __init__(self, *answers):
            self.answers = list(answers)
            self.sent = []

        def run(self, cmd, **named):
            self.sent.append(next((arg for arg in cmd
                                   if arg.startswith("If-None-Match")), None))
            answer = self.answers.pop(0)
            # gh prints the status line and headers only when asked to.
            answer.stdout = (answer.head if "--include" in cmd else "") + \
                answer.body
            return answer

    real_subprocess = prwatch.subprocess
    script = prwatch.subprocess = Script(
        Answer(200, 'W/"one"', '{"n": 1}'),
        Answer(304, 'W/"one"'),
        Answer(200, 'W/"two"', '{"n": 2}'),
        Answer(304, 'W/"two"'),
        Answer(304),
        Answer(200, 'W/"three"', '{"n": 3}'))
    problems = []
    try:
        gh = prwatch.GitHub("github.com")
        got = []
        for _ in range(4):
            got.append(gh.get("repos/o/r/pulls/1")["n"])
            gh.forget_unread()
        if got != [1, 1, 2, 2]:
            problems.append(f"the readings were {got}")
        try:
            gh.get("repos/o/r/pulls/2")
            problems.append("a 304 with nothing to reuse was taken as an answer")
        except prwatch.GitHubError:
            pass
        gh.forget_unread()
        gh.forget_unread()
        if gh.get("repos/o/r/pulls/1")["n"] != 3:
            problems.append("the answer after two polls without it was wrong")
    finally:
        prwatch.subprocess = real_subprocess
    wanted = [None, 'If-None-Match: W/"one"', 'If-None-Match: W/"one"',
              'If-None-Match: W/"two"', None, None]
    if script.sent != wanted:
        problems.append(f"the requests named {script.sent}")
    if problems:
        print("FAIL an answer that has not changed is reused")
        for problem in problems:
            print(f"       {problem}")
        return False
    print("ok   an answer that has not changed is reused")
    return True


