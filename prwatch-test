    cases about it read the number rather than the wait it produces. This
    one drives the loop itself, with a clock that moves when the watch
    sleeps, and records when each poll lands.
    """

    class Enough(Exception):
        """Long enough: the case has the polls it came for."""

    comment = {"1": {"user": "someone", "updated": "2026-09-20T10:00:00Z",
                     "url": "u", "body": "one more thing"}}
