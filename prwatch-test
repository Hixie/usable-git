@case
def quoting_drops_the_furniture():
    body = ("<!-- bot:v=1 -->\n**One real sentence.** "
            "<sub>[Fix all](https://example.invalid/a/very/long/link/indeed) | "
            "[Re-run](https://example.invalid/another/very/long/link)</sub>")
