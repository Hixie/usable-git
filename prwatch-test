class Options:
    """The defaults, so each case names only what it cares about."""

    def __init__(self, **overrides):
        defaults = dict(expect=None, status=False, once=False, follow=False,
                        interval=60, interval_growth=2, interval_max=240,
                        heartbeat=900, stall=1800, stall_growth=2,
                        stall_max=86400, stability=3, min_checks=0,
                        no_ci_grace=900, warn_after=3, max_lines=12,
                        detail=True, fresh=True, state=None, exit_code=False,
                        require_review=None, excerpt=300,
                        for_seconds=None, github_webhook_relay=None,
                        landed=False)
        defaults.update(overrides)
        self.__dict__.update(defaults)


def check(name, snapshot_fields, known, options=None, head="a" * 40):
    """Absorb one snapshot on top of `known` and return the lines emitted."""
    watcher = prwatch.Watcher(prwatch.GitHub("github.com"), "o", "r", 1,
                              options or Options())
    watcher.known.update(known)
    watcher.head = known.get("_head", head)
    watcher.merge_state = known.get("_merge")
    snap = prwatch.Snapshot()
    for field, value in snapshot_fields.items():
        setattr(snap, field, value)
    out = io.StringIO()
    with redirect_stdout(out):
        watcher.absorb(snap, announce=True)
    return name, watcher, out.getvalue()


def run_check(fn, expected, forbidden=()):
    name, watcher, output = fn()
    problems = [f"missing {want!r}" for want in expected if want not in output]
    problems += [f"unwanted {no!r}" for no in forbidden if no in output]
    if problems:
        print(f"FAIL {name}")
        for problem in problems:
            print(f"       {problem}")
        print("     got:")
        for line in output.splitlines():
            print(f"       {line}")
        return False
    print(f"ok   {name}")
    return True


MERGE = "m" * 40


def pull(head="a" * 40, state="open", merged=False, mergeable="clean",
         merged_at="1970-01-01T00:16:40Z"):
    """One reading of a pull request, as the REST API gives it.

    GitHub works out whether a branch merges only for an open pull request,
    and only once it has got to it. Every other reading gives a merge state
    of "unknown" and a null mergeable field, so that pairing is made here
    rather than named at each call. A merged pull request was merged as
    MERGE, by default at 1000 seconds into the epoch, where a Clock starts.
    """
    if state != "open":
        mergeable = "unknown"
    answered = None if mergeable == "unknown" else mergeable != "dirty"
    merge = {"merge_commit_sha": MERGE, "merged_at": merged_at} \
        if merged else {}
    return {**merge,
            "head": {"sha": head, "ref": "feature", "repo": {"id": 7}},
            "state": state, "merged": merged,
            "mergeable_state": mergeable, "title": "t", "draft": False,
            "mergeable": answered, "number": 1,
            "base": {"ref": "main", "repo": {"id": 7, "full_name": "o/r"}},
            "html_url": "https://example.invalid/pull/1"}


def check_run(name, status="completed", conclusion="success", cid=None):
    return {cid or name: {"name": name, "status": status,
                          "conclusion": conclusion, "url": "u", "app": "a"}}


def workflow(name="CI", status="completed", conclusion="success", rid="1"):
    return {rid: {"name": name, "status": status, "conclusion": conclusion,
                  "url": "u", "attempt": 1, "event": "pull_request"}}


def base_run(rid, commit=MERGE, name="Tests", workflow=1,
             status="completed", conclusion="success", failed=None):
    """One run a push to main started, as read_base_runs() gives it."""
    run = {rid: {"name": name, "status": status, "conclusion": conclusion,
                 "url": f"u{rid}", "attempt": 1, "event": "push",
                 "workflow": workflow, "commit": commit,
                 "created": f"2026-10-23T00:{int(rid):02d}:00Z"}}
    if failed:
        run[rid]["failed"] = [{"name": job, "conclusion": "failure",
                               "url": f"j-{job}"} for job in failed]
    return run


def review(user="cubic-dev-ai[bot]", commit="a" * 40, rid="1", state="COMMENTED"):
    return {rid: {"user": user, "state": state, "commit": commit, "url": "u",
                  "body": "looks fine"}}


def thread(resolved=False, tid="t1"):
    return {tid: {"resolved": resolved, "outdated": False, "path": "f.py",
                  "line": 1, "author": "someone", "url": "u", "body": "why?"}}


class Clock:
    """A stand-in for the time module, so a test can skip ahead by hours.

    Sleeping moves it rather than waiting, so a case about a wait of four
    minutes takes no longer than one about a wait of four seconds.
    """

    def __init__(self, now=1000.0):
        self.now = now

    def time(self):
        return self.now

    def sleep(self, seconds):
        self.now += seconds

    def strftime(self, fmt):
        return "00:00"


CASES = []


