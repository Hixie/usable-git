    watcher.relay = object()
    watcher.known["threads"] = thread()
    heard_by(watcher, "pull_request_review_thread", webhook_for(
        pull_request={"number": 1}, action="resolved",
        thread={"node_id": "t1"}))
    heard_by(watcher, "check_run", webhook_for(check_run=gh_check(
        cid=10, status="queued", conclusion=None)))

    def lagging():
        snap = prwatch.Snapshot()
        snap.threads = thread()
        snap.checks = dict(watcher.known["checks"])
        return snap

    first = lagging()
    watcher.doubt(first)
    doubted = sorted(watcher.wanted & {"threads", "checks"})
    caught_up = prwatch.Snapshot()
    caught_up.threads = thread(resolved=True)
    caught_up.checks = {**watcher.known["checks"], "10": prwatch.check_item(
