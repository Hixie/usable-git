@case
def a_webhook_that_was_overtaken_is_read_for():
    """An older word about an item never replaces a newer one.

    An item GitHub stamped as changed earlier than the one held is passed
    over. An item ordered only by how far along it is, such as a check, is
    read for, since only a read can say whether the webhook was overtaken or
    the item went back. A deleted comment stays deleted.
    """
    watcher = quiet_watcher(Options())
    watcher.known["issue_comments"] = {"1": prwatch.comment_item(
        gh_comment(updated="2026-09-20T11:00:00Z", body="second thoughts"))}
    watcher.known["checks"]["9"] = prwatch.check_item(
        gh_check(status="in_progress", conclusion=None))
    old_edit, old_reads = heard_by(watcher, "issue_comment", webhook_for(
        issue={"number": 1}, action="edited",
        comment=gh_comment(updated="2026-09-20T10:00:00Z", body="first")))
    new_edit, _ = heard_by(watcher, "issue_comment", webhook_for(
        issue={"number": 1}, action="edited",
        comment=gh_comment(updated="2026-09-20T12:00:00Z", body="third")))
    heard_by(watcher, "check_run", webhook_for(check_run=gh_check(
        status="completed", conclusion="success")))
    late, late_reads = heard_by(watcher, "check_run", webhook_for(
        check_run=gh_check(status="in_progress", conclusion=None)))
    gone, _ = heard_by(watcher, "issue_comment", webhook_for(
        issue={"number": 1}, action="deleted", comment=gh_comment()))
    back, _ = heard_by(watcher, "issue_comment", webhook_for(
        issue={"number": 1}, action="edited",
        comment=gh_comment(updated="2026-09-20T13:00:00Z", body="fourth")))
    watcher.known["pull"] = {**pull(), "updated_at": "2026-09-20T12:00:00Z"}
    stale_merge, stale_reads = heard_by(watcher, "pull_request", webhook_for(
        action="closed", pull_request={**pull(state="closed", merged=True),
                                       "updated_at": "2026-09-20T11:00:00Z"}))
    merge, _ = heard_by(watcher, "pull_request", webhook_for(
        action="closed", pull_request={**pull(state="closed", merged=True),
                                       "updated_at": "2026-09-20T13:00:00Z"}))
    problems = []
    if old_edit or old_reads:
        problems.append(f"an overtaken edit said {old_edit.strip()!r} and "
                        f"read {old_reads}")
    if "edited" not in new_edit:
        problems.append(f"a newer edit said {new_edit.strip()!r}")
    if late or late_reads != {"checks"} or \
            watcher.known["checks"]["9"]["status"] != "completed":
        problems.append(f"a late start said {late.strip()!r}, read "
                        f"{late_reads}, and left the check "
                        f"{watcher.known['checks']['9']['status']}")
    if gone or back or "1" in watcher.known["issue_comments"]:
        problems.append("a deleted comment came back")
    if stale_merge or stale_reads or "MERGED" not in merge:
        problems.append(f"an overtaken pull request said "
                        f"{stale_merge.strip()!r}, and a newer one said "
                        f"{merge.strip()!r}")
    return report("a webhook that was overtaken is read for", problems, "")


@case
def a_read_that_goes_back_on_a_webhook_is_read_twice():
    """A read can answer from before a change already heard of."""
    watcher = quiet_watcher(Options())
    watcher.relay = object()
    newer = prwatch.comment_item(gh_comment(updated="2026-09-20T12:00:00Z",
                                            body="newer"))
    older = prwatch.comment_item(gh_comment(updated="2026-09-20T11:00:00Z",
                                            body="older"))
    watcher.known["issue_comments"] = {"1": newer}
    watcher.known["pull"] = {**pull(state="closed", merged=True),
                             "updated_at": "2026-09-20T12:00:00Z"}
    watcher.gone.add(("review_comments", "7"))
    watcher.known["review_comments"] = {}

    def lagging():
        snap = prwatch.Snapshot()
        snap.issue_comments = {"1": older}
        snap.pull = {**pull(), "updated_at": "2026-09-20T11:00:00Z"}
        snap.review_comments = {"7": older}
        return snap

    first = lagging()
    watcher.doubt(first)
    doubted = (first.issue_comments["1"]["body"], first.pull["state"],
               sorted(first.review_comments), sorted(watcher.wanted))
    second = lagging()
    watcher.doubt(second)
    believed = (second.issue_comments["1"]["body"], second.pull["state"],
                sorted(second.review_comments), sorted(watcher.doubted))
    problems = []
    if doubted != ("newer", "closed", [], ["issue_comments", "pull",
                                           "review_comments"]):
        problems.append(f"the first read was taken as {doubted}")
    if believed != ("older", "open", ["7"], []):
        problems.append(f"the second read was taken as {believed}")
    return report("a read that goes back on a webhook is believed when read "
                  "twice", problems, "")


