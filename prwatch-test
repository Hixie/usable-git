    return good


@case
def an_outage_in_the_stand_in_is_not_a_refusal():
    """A blip while reading the stand-in is a blip, not a permission."""

    class Flaky(RefusedChecks):
        def paged(self, path, key=None, per_page=100):
            if "/check-runs" in path:
                return super().paged(path, key, per_page)
            raise prwatch.GitHubError("gh failed (HTTP 502)", 502)

    snap = prwatch.Snapshot()
    snap.runs = workflow()
    raised = None
    try:
        prwatch.read_checks(Flaky([], {}), "o", "r", "a" * 40, snap)
    except prwatch.GitHubError as error:
        raised = error
    good = raised is not None and not prwatch.forbidden(raised)
    print("ok   a failure while reading the stand-in is not called permanent"
          if good else f"FAIL stand-in outage: {raised!r}")
    return good


@case
def a_throttle_is_not_a_permission():
    """GitHub answers 403 both for "not allowed" and for "slow down"."""
    good = (not prwatch.forbidden(prwatch.GitHubError(
                "You have triggered an abuse detection mechanism "
                "(HTTP 403)", 403))
