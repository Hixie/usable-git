@case
def an_outage_in_the_stand_in_is_not_a_refusal():
    """A blip while reading the stand-in is a blip, not a permission."""

    class Flaky(RefusedChecks):
        def paged(self, path, key=None, per_page=100):
            if "/check-runs" in path:
                return super().paged(path, key, per_page)
            raise prwatch.GitHubError("gh failed (HTTP 502)", 502)

    def stand_in_error(gh, snap):
        try:
            prwatch.read_checks(gh, "o", "r", "a" * 40, snap)
        except prwatch.GitHubError as error:
            return error

    snap = prwatch.Snapshot()
    snap.runs = workflow()
    raised = stand_in_error(Flaky([], {}), snap)
    # The runs are the stand-in's first part, so a failure to read them is
    # the stand-in's failure, and a refusal of them is a refusal.
    unread = prwatch.Snapshot()
    unread.errors["runs"] = prwatch.GitHubError("left a run out")
    blip = stand_in_error(RefusedChecks([], {}), unread)
    unread.errors["runs"] = prwatch.GitHubError("refused (HTTP 403)", 403)
    refusal = stand_in_error(RefusedChecks([], {}), unread)
    good = raised is not None and not prwatch.forbidden(raised) and \
        blip is not None and not prwatch.forbidden(blip) and \
        refusal is not None and prwatch.forbidden(refusal)
    print("ok   a failure while reading the stand-in is not called permanent"
          if good else f"FAIL stand-in outage: {raised!r} / {blip!r} / "
                       f"{refusal!r}")
    return good


