@case
def a_lost_relay_reads_everything_and_polls_until_it_answers():
    """Webhooks sent while the relay was lost are lost with it.

    Each poll after the loss tries to connect again, and the poll after an
    attempt that succeeded takes it up, reading everything once more.
    """
    answers = []

    class Down:
        lost = "the webhook relay at r:1 cannot be connected to"
        ready = FakeRelay(None, [], 0).ready

    def reconnect(clock):
        answers.append(round(clock.now))
        return Down() if clock.now < 1300 else FakeRelay(clock, [], 3000)

    output, polls, _ = relayed(lambda now: {}, [(1000, None)], horizon=3000,
                               reconnect=reconnect,
                               github_webhook_relay="r:1")
    problems = []
    if polls[:2] != [0, 1000] or answers != polls[1:-1] or \
            answers[-1] < 1300 or answers[-2] >= 1300:
        problems.append(f"it read {polls} and connected at {answers}")
    for wanted in ("closed the connection; polling until",
                   "can be reached again; listening"):
        if wanted not in output:
            problems.append(f"it never said {wanted!r}")
    return report("a lost relay is read past, and connected to again",
                  problems, output)


