@case
def a_relayed_watch_reads_main_when_its_runs_move():
    """A relayed --landed watch reads main's runs when the merge and each
    run that may count are heard of, and at no other time.

    The run for the merge is cancelled and the run after it passes, which
    makes the verdict LANDED. Nothing heard of after that is read for.
    """
    merged = {**pull(state="closed", merged=True, merged_at=
                     "1970-01-01T00:16:40Z"),
              "updated_at": "2026-09-20T12:00:00Z"}
    later = "b" * 40

    def readings(now):
        if now < 1000:
            return {}
        runs = base_run("1", status="queued", conclusion=None)
        if now >= 2000:
            runs = {**base_run("1", conclusion="cancelled"),
                    **base_run("2", later, status="in_progress",
                               conclusion=None)}
        if now >= 3000:
            runs["2"] = base_run("2", later)["2"]
        return {"state": "closed", "merged": True, "base_runs": runs}

    output, polls, _ = relayed(readings, [
        (1000, ("pull_request", webhook_for(action="closed",
                                            pull_request=merged))),
        (2000, ("workflow_run", webhook_for(workflow_run=gh_base_run(
            1, conclusion="cancelled")))),
        (2001, ("workflow_run", webhook_for(workflow_run=gh_base_run(
            2, later, "in_progress", None)))),
        (3000, ("workflow_run", webhook_for(workflow_run=gh_base_run(
            2, later)))),
        (4000, ("workflow_run", webhook_for(workflow_run=gh_base_run(
            3, "c" * 40, "queued", None))))], horizon=5000, landed=True)
    problems = []
    if polls != [0, (1000, {"base_runs"}), (2000, {"base_runs"}),
                 (3000, {"base_runs"})]:
        problems.append(f"it read {polls}")
    said = [tag for tag in tags(output) if tag not in ("PROGRESS", "STALL")]
    if said[3:] != ["MERGED", "RUN", "CANCEL", "RUN", "RUN", "WAITING"] or \
            "WAITING  LANDED" not in output:
        problems.append(f"it said {said}")
    return report("a relayed --landed watch reads main when its runs move",
                  problems, output)


