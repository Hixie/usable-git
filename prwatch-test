            try:
                prwatch.main(["--once", "--for", "0"])
                refused = False
            except SystemExit:
                refused = True
            try:
                prwatch.main(["--once", "--for", "nan"])
                refused = False
            except SystemExit:
                pass
    finally:
        (prwatch.resolve_target, prwatch.app_from_environment,
         prwatch.Watcher.run, handlers) = saved
        for number, handler in handlers.items():
            signal.signal(number, handler)
    said = out.getvalue()
    good = status == 0 and refused and "STOPPED" in said and \
