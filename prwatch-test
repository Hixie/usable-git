    if watcher.announced or watcher.doubted or watcher.wanted:
        problems.append(f"a read that caught up left {watcher.announced}, "
                        f"{watcher.doubted} and {watcher.wanted}")
    return report("a read that misses what a webhook announced is read again",
                  problems, "")


