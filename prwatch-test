        def refuse_twice_then_answer():
            polls.append(clock.now)
            snap = prwatch.Snapshot()
            if len(polls) > 2:
                snap.pull = pull()
                return snap
            snap.errors["pull"] = prwatch.GitHubError(
                "gh: API rate limit exceeded for user ID 551196 (HTTP 403)",
                403)
            watcher.gh.rate_limited_until = clock.now + 240
            return snap

        watcher.poll = refuse_twice_then_answer
        out = io.StringIO()
