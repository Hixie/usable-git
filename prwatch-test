                        f"{going['4'].get('failed')}")
    listing = ("repos/o/r/actions/runs?branch=release%2F1&event=push"
               "&created=")
    open_ended = listing + "%3E%3D2026-10-23T00:09:29Z"
    cut = listing + "2026-10-23T00:09:29Z..2026-10-23T00:04:00Z"
    if asked_first[0] != open_ended or \
            sum("/compare/" + MERGE in path for path in asked_first) != 5:
        problems.append(f"the first read asked {asked_first}")
    if asked_again[0] != cut or \
