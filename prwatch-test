    return good


# -- reading failures -------------------------------------------------------

@case
def an_unread_facet_is_not_a_zero():
    _, watcher, _ = check(
        "an unread facet",
        {"pull": pull(), "checks": check_run("Test"), "runs": workflow(),
         "statuses": {}},
        {"pull": pull()})
    line = watcher.status_line()
    settled, reason = watcher.is_settled()
    out = io.StringIO()
    watcher.options.detail = False
    with redirect_stdout(out):
        verdict = watcher.final_report(reason, settled)
    good = "comments ? issue / ? inline" in line and verdict == "UNKNOWN"
    print("ok   a facet never read prints ? and blocks a green verdict"
          if good else f"FAIL unread facet: {line} / {verdict}")
    return good


@case
def a_failed_read_keeps_what_it_had():
    """The bug this replaced: an empty result taken as a deletion."""
    known = {"pull": pull(), "issue_comments": {"1": {
        "user": "someone", "updated": "t", "url": "u", "body": "hello"}}}
    snap = prwatch.Snapshot()
    snap.pull = pull()
    snap.errors["issue_comments"] = "simulated outage"
    watcher = prwatch.Watcher(prwatch.GitHub("github.com"), "o", "r", 1,
                              Options(warn_after=1))
    watcher.known.update(known)
    watcher.head = "a" * 40
    out = io.StringIO()
    with redirect_stdout(out):
        watcher.report_errors(snap)
        watcher.absorb(snap, announce=True)
        # the next poll succeeds and returns exactly what was there before
        recovered = prwatch.Snapshot()
        recovered.pull = pull()
        recovered.issue_comments = known["issue_comments"]
        watcher.report_errors(recovered)
        watcher.absorb(recovered, announce=True)
    output = out.getvalue()
    good = ("WARN" in output and "reading again" in output
            and "COMMENT" not in output
            and watcher.known["issue_comments"] == known["issue_comments"])
    print("ok   a failed read changes nothing and re-announces nothing"
          if good else f"FAIL failed read: {output}")
    return good


# -- reviews ----------------------------------------------------------------

@case
def a_review_of_an_older_commit_does_not_count():
    _, watcher, _ = check(
        "a review of an older commit",
        {"pull": pull(), "checks": check_run("Test"), "runs": workflow(),
         "statuses": {}, "issue_comments": {}, "review_comments": {},
         "reviews": review(commit="b" * 40), "threads": {}},
        {"pull": pull()}, Options(require_review="*"))
    line = watcher.status_line()
    outstanding = watcher.outstanding_lines()
    good = ("reviews 1 (none on this head)" in line
            and any("no review of" in item for item in outstanding))
    print("ok   a review of an older commit is not a review of this one"
          if good else f"FAIL stale review: {line} / {outstanding}")
    return good


@case
def a_review_of_this_commit_counts():
    _, watcher, _ = check(
        "a review of this commit",
        {"pull": pull(), "reviews": review(), "threads": {}},
        {"pull": pull()}, Options(require_review="cubic"))
    good = ("reviews 1 (1 on this head)" in watcher.status_line()
            and not watcher.outstanding_lines())
    print("ok   a review of the watched commit satisfies --require-review"
          if good else f"FAIL fresh review: {watcher.status_line()}")
    return good


@case
def a_required_reviewer_who_has_not_come():
