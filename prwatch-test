                              Options(once=True))
    polls = []

    def refuse():
        polls.append("polled")
        snap = prwatch.Snapshot()
        snap.errors["pull"] = prwatch.GitHubError(
            "gh: API rate limit exceeded for user ID 551196 (HTTP 403)", 403)
        return snap

    watcher.poll = refuse
    watcher.sleep = waiting_is_wrong
    complaint = None
    waited = False
    try:
        with redirect_stdout(io.StringIO()):
            watcher.first_poll()
    except SystemExit as raised:
        complaint = str(raised)
    except Waited:
        waited = True
    good = not waited and complaint is not None and polls == ["polled"]
    print("ok   --once reports a throttle rather than waiting it out" if good
          else f"FAIL --once and a throttle: waited={waited} "
               f"complaint={complaint!r} polls={polls}")
    return good


@case
def a_refusal_at_the_first_poll_is_still_fatal():
    """An answer that will not change is not one to wait for.

    A permission the token has not got, a pull request that is not there,
    and a network failure are each answered the same way on the next poll as
    on this one, so each ends the run rather than starting a wait.
    """
    problems = []
    for error in (prwatch.GitHubError("Resource not accessible by personal "
                                      "access token (HTTP 403)", 403),
                  prwatch.GitHubError("Not Found (HTTP 404)", 404),
                  prwatch.GitHubError("dial tcp: no such host", None)):
        watcher = prwatch.Watcher(prwatch.GitHub("github.com"), "o", "r", 1,
                                  Options())
        polls = []

        def refuse():
            polls.append("polled")
            snap = prwatch.Snapshot()
            snap.errors["pull"] = error
            return snap

        watcher.poll = refuse
        watcher.sleep = waiting_is_wrong
        complaint = None
        try:
            with redirect_stdout(io.StringIO()):
                watcher.first_poll()
        except SystemExit as raised:
            complaint = str(raised)
        except Waited:
            problems.append(f"{error} started a wait that would never end")
            continue
        if complaint is None:
            problems.append(f"{error} did not end the run")
        elif "cannot read o/r#1" not in complaint or str(error) not in \
                complaint:
            problems.append(f"{error} was reported as {complaint!r}")
        if polls != ["polled"]:
            problems.append(f"{error} was read {len(polls)} times: {polls}")
    if problems:
        print("FAIL a refusal at the first poll is still fatal")
        for problem in problems:
            print(f"       {problem}")
        return False
    print("ok   a failure that will not clear still ends the run at once")
    return True


